# GeoAssets Harness Configuration (dotnet / C# 14 / .NET 10)
PROJECT_NAME="GeoAssets"
TICKET_PREFIX="XD01"

STACK_PROFILE="dotnet"
INTEGRATION_BRANCH="origin/develop"
MERGE_TARGET_BRANCH="develop"
PROTECTED_BRANCHES="main master"

export DOTNET_CLI_HOME="${TMPDIR:-/tmp}/dotnet-cli-home"
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE="1"
export DOTNET_CLI_TELEMETRY_OPTOUT="1"
export NUGET_PACKAGES="${NUGET_PACKAGES:-$HOME/.nuget/packages}"
export MSBUILDDISABLENODEREUSE="1"
export UseSharedCompilation="false"
mkdir -p "${DOTNET_CLI_HOME}"

INIT_CMD="dotnet restore GeoAssets.sln --disable-build-servers -m:1 --nologo --verbosity quiet"
FORMAT_CHECK_CMD="dotnet format style GeoAssets.sln --verify-no-changes --no-restore --verbosity diagnostic"
FORMAT_FIX_CMD="dotnet format style GeoAssets.sln"
BUILD_AND_LINT_CMD="dotnet build GeoAssets.sln --no-incremental /warnaserror -p:GeoAssetsOracleSkipAppleTfms=true -consoleLoggerParameters:NoSummary"
ARCH_TEST_CMD="dotnet test tests/GeoAssets.Server.Tests/GeoAssets.Server.Tests.csproj --no-build --nologo --filter Category=Architecture"
UNIT_TEST_CMD="dotnet test GeoAssets.sln --no-build --nologo"

# On macOS, confirm the Apple TFMs still compile for real (baseline, no /warnaserror) — XD01-293
if [[ "$(uname)" == "Darwin" ]]; then
    STAGE2_POST_CHECK_CMD="dotnet build apps/GeoAssets.MAUI/GeoAssets.MAUI.csproj -f net10.0-ios --no-incremental -consoleLoggerParameters:NoSummary && dotnet build apps/GeoAssets.MAUI/GeoAssets.MAUI.csproj -f net10.0-maccatalyst --no-incremental -consoleLoggerParameters:NoSummary"
fi

# E2E Agentic Environment Configuration
E2E_API_BASE_URL="http://localhost:8080"
E2E_WEB_BASE_URL="http://localhost:8081"
E2E_HEALTH_ENDPOINT="/healthz"
E2E_MAX_RETRIES="2"
