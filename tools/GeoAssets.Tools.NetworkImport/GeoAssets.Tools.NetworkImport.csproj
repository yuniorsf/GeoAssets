<Project Sdk="Microsoft.NET.Sdk">

  <!-- CLI over the network import pipeline: inventory | plan | import | verify. Writes to the kernel only through
       its REST bulk-import endpoint (ADR-001 Invariant 1): never references GeoAssets.Provider.PostgreSQL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Tools.NetworkImport</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.Tools.NetworkImport.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Ingestion\GeoAssets.Ingestion.csproj" />
    <ProjectReference Include="..\..\providers\GeoAssets.Ingestion.Shapefile\GeoAssets.Ingestion.Shapefile.csproj" />
    <ProjectReference Include="..\..\providers\GeoAssets.Ingestion.Proj\GeoAssets.Ingestion.Proj.csproj" />
    <!-- XD01-466: the plan verb's export option writes the plan as FlatGeobuf/GeoParquet with the GDAL plugin's IVectorFileWriter
         (statically referenced, like Ingestion.Proj's GDAL; this host never reads a plugin directory). -->
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.Gdal\GeoAssets.Provider.Gdal.csproj" />
    <ProjectReference Include="..\..\plugins\ingestion\GeoAssets.Ingestion.Profiles\GeoAssets.Ingestion.Profiles.csproj" />
  </ItemGroup>

</Project>
