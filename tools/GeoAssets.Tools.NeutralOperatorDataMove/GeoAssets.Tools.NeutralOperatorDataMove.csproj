<Project Sdk="Microsoft.NET.Sdk">

  <!-- XD01-391: the one-off, re-runnable move of the NeutralOperator orders the kernel hosted (ADR-001 Phase 7) from the
       kernel's GeoAssets database to GeoAssets.NeutralOperator.Server's own database. It reads the table and column names
       from the two EF models it moves (ServiceOrderDbContext, NeutralOperatorDbContext) and the order types from the
       NeutralOperator module itself; it never references GeoAssets.Provider.PostgreSQL (no geo_entity data moves). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Tools.NeutralOperatorDataMove</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.Tools.NeutralOperatorDataMove.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\verticals\NeutralOperator\GeoAssets.NeutralOperator.Modules\GeoAssets.NeutralOperator.Modules.csproj" />
    <ProjectReference Include="..\..\verticals\NeutralOperator\GeoAssets.NeutralOperator.Persistence\GeoAssets.NeutralOperator.Persistence.csproj" />
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.EFCore\GeoAssets.Workflow.EFCore.csproj" />
  </ItemGroup>

</Project>
