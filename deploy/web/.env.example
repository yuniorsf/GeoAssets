# Copy to .env and fill in real values. Never commit the populated .env file.

# Application Insights connection string for the browser (Observability:AzureMonitor:ConnectionString)
# (InstrumentationKey=...;IngestionEndpoint=...). Empty = no browser telemetry.
GEOASSETS_APPINSIGHTS_CONNECTION_STRING=

# CIAM sign-in (AzureAdCiam:Authority/ClientId, GeoAssetsServer:ApiScope, GeoAssetsIpBillingServer:ApiScope) — the values
# of apps/GeoAssets.Web/wwwroot/appsettings.Local.json, which the image never contains. The Web SPA registration must list
# http://localhost:8081/authentication/login-callback as a redirect URI; open the app at http://localhost:8081 (the
# gateway's CORS origin, deploy/server WEB_ORIGIN), not 127.0.0.1. Blank IP-billing scope = the kernel's ApiScope.
GEOASSETS_CIAM_AUTHORITY=https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/YOUR_CIAM_TENANT_ID
GEOASSETS_CIAM_CLIENT_ID=
GEOASSETS_API_SCOPE=api://<kernel API client id>/access_as_user
GEOASSETS_IPBILLING_API_SCOPE=
