# Copy to .env and fill in. Never commit the populated .env file.

# The kernel stack's Postgres password — the same value as deploy/server/.env (this stack reuses that Postgres
# container, with its own database geoassets_neutral_operator).
POSTGRES_PASSWORD=

# Optional overrides (defaults shown).
# POSTGRES_HOST=postgres
# GEOCORE_SERVER_BASE_URL=http://server:8080
# WORKFLOW_OUTBOX_TRANSPORT=None

# GeoAssets.ServiceCaller client credentials of this host's service principal (XD01-299). Leave disabled locally: the
# host still boots, /healthz answers 200 and the vertical-registration check reports Degraded until they are set.
# SERVICE_AUTH_ENABLED=false
# SERVICE_AUTH_TENANT_ID=
# SERVICE_AUTH_CLIENT_ID=
# SERVICE_AUTH_CLIENT_SECRET=
# SERVICE_AUTH_SCOPE=api://geoassets-server/.default

# Bearer-token validation (XD01-390): this host's own API registration, which the kernel must list in its
# AzureAdCiam__AdditionalAudiences__N (this host forwards the caller's token to the kernel's identity routes) — or,
# alternatively, the kernel's API audience. See README.md "Token audiences".
# AzureAdCiam__Instance=https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/
# AzureAdCiam__TenantId=
# AzureAdCiam__ClientId=
