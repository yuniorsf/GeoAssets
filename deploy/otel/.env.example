# Copy to .env and fill in real values. Never commit the populated .env file.

# New Relic — Ingest/License key (Account settings > API keys).
NEW_RELIC_LICENSE_KEY=

# Datadog — API key (Organization Settings > API Keys) and site
# (datadoghq.com, datadoghq.eu, us3.datadoghq.com, ...).
DD_API_KEY=
DD_SITE=datadoghq.com

# Azure Monitor — Application Insights connection string
# (InstrumentationKey=...;IngestionEndpoint=...).
AZURE_MONITOR_CONNECTION_STRING=
