# One file per company: copy to deploy/distributor-silo/<company>.env (git-ignored) and fill in. Never commit it.
#   cp deploy/distributor-silo/.env.example deploy/distributor-silo/coelba.env
# Then pass it to every docker compose call of that company's silo with --env-file (see README.md).

# The company id: lowercase letters, digits and '_' only, starting with a letter. It names the Compose project
# (geoassets-silo-<COMPANY>), the container (geoasset-server-<COMPANY>) and the database (geoassets_<COMPANY>) — the same
# value as provision-database.sh's argument.
COMPANY=coelba

# The X-Tenant-Domain value the gateway routes to this silo (README.md "Route the gateway to the silo"); also the
# network-import CLI's --tenant-domain.
TENANT_DOMAIN=coelba.local

# Host port, bound to 127.0.0.1 only. One per company: 8180 coelba, 8181 cemar, 8182 cepisa, … (deploy/server uses 5433,
# 8080 and 8090, deploy/web 8081, deploy/neutral-operator 8082).
SILO_PORT=8180

# The deploy/server Postgres password (POSTGRES_PASSWORD in deploy/server/.env): the silo's database lives in that
# container.
POSTGRES_PASSWORD=replace-with-the-deploy-server-password

# The kernel API's CIAM registration — the same values as deploy/server/.env (README.md "Credentials"). Unset: every
# authenticated call answers 401.
AzureAdCiam__Instance=https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/
AzureAdCiam__TenantId=YOUR_CIAM_TENANT_ID
AzureAdCiam__ClientId=YOUR_KERNEL_API_CLIENT_ID
# Extra audiences, as in deploy/server/.env (blank = the kernel API's own only). A silo needs none for the CLI.
AzureAdCiam__AdditionalAudiences__0=
AzureAdCiam__AdditionalAudiences__1=

# Optional (defaults shown).
# POSTGRES_HOST=postgres
# SILO_IMAGE=geoassets-server-silo:local
# GEOASSETS_TELEMETRY_EXPORT=false
# Observability__Otlp__Endpoint=https://otlp.nr-data.net:4317
# Observability__Otlp__Protocol=Grpc
