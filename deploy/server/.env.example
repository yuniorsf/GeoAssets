# Copy to .env and fill in a real value. Never commit the populated .env file.
# This is a local dev Postgres credential, not a vendor secret — no Key Vault
# entry needed (unlike deploy/otel/.env, which is Key Vault-backed).
POSTGRES_PASSWORD=

# XD01-384 (optional): which host serves the NeutralOperator vertical behind the gateway. By default the kernel keeps
# hosting the module (GeoAssets__Modules__1=neutral-operator) and the gateway's NeutralOperator destination is the kernel.
# To use deploy/neutral-operator's GeoAssets.NeutralOperator.Server instead (it needs ServiceAuth credentials and a broker
# for its approval saga — see deploy/neutral-operator/README.md):
# KERNEL_NEUTRAL_OPERATOR_MODULE=
# NEUTRAL_OPERATOR_DESTINATION=http://neutral-operator:8080
