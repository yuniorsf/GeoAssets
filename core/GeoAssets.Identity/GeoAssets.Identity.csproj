<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Identity</RootNamespace>
  </PropertyGroup>

  <!-- Authentication: reads Azure AD claims from ClaimsPrincipal (no extra dep needed).
       The host configures Azure AD middleware (e.g. Microsoft.Identity.Web). -->

  <!-- IGeoAuthenticationProvider (XD01-48) is expressed purely in terms of IServiceCollection/
       IConfiguration — the lightweight abstraction packages below, not the full ASP.NET Core
       framework — so this project stays safe to reference from GeoAssets.Web (Blazor WASM,
       which cannot take a Microsoft.AspNetCore.App FrameworkReference) as well as
       GeoAssets.Server. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

</Project>
