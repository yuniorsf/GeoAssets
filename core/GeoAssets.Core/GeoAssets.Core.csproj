<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- GeoAssets.Core.Tests: fakes implementing the internal IProviderDecorator for AssetProviderExtensions tests.
         GeoAssets.Shared: ObservableAssetProvider implements IProviderDecorator (XD01-160). -->
    <InternalsVisibleTo Include="GeoAssets.Core.Tests" />
    <InternalsVisibleTo Include="GeoAssets.Shared" />
  </ItemGroup>

</Project>
