<Project Sdk="Microsoft.NET.Sdk">

  <!-- Distributor network import pipeline: canonical electrical network model, stage ports (source, profile,
       coordinate transform, sink) and the engine (topology resolution, validation, projection to GeoFeature).
       Pure: no file formats, no PROJ, no HTTP, no database — those are adapters. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Ingestion</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.Ingestion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoAssets.Core\GeoAssets.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

</Project>
