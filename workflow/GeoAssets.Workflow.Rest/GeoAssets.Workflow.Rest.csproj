<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Workflow.Rest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- WorkflowProblemTranslator and the wire envelopes are internal; their mapping is tested directly. -->
    <InternalsVisibleTo Include="GeoAssets.Workflow.Rest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Core\GeoAssets.Core.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Workflow\GeoAssets.Workflow.csproj" />
    <!-- IServiceAuthTokenProvider and ModulePermissionSet (XD01-382): the kernel's machine-to-machine clients
         (RestTargetLedgerClient, RestVerticalRegistrationClient) authenticate as GeoAssets.ServiceCaller. -->
    <ProjectReference Include="..\..\core\GeoAssets.Identity\GeoAssets.Identity.csproj" />
  </ItemGroup>

</Project>
