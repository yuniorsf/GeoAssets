<Project Sdk="Microsoft.NET.Sdk">

  <!-- PROJ-backed coordinate transformer of the network import pipeline. PROJ picks the most accurate available
       SAD69 → SIRGAS 2000 operation (the IBGE grid br_ibge_SAD69_003.tif when it is on the PROJ search path,
       a Helmert otherwise — 65.7 m vs 4.9 m vs reference near Salvador). Same GDAL bindings and version as
       GeoAssets.Provider.FileGeodatabase (XD01-225). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Ingestion.Proj</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.Ingestion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Ingestion\GeoAssets.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaxRev.Gdal.Core" Version="3.13.3.611" />
    <PackageReference Include="MaxRev.Gdal.MacosRuntime.Minimal" Version="3.13.3.611" />
    <PackageReference Include="MaxRev.Gdal.LinuxRuntime.Minimal" Version="3.13.3.611" />
  </ItemGroup>

</Project>
