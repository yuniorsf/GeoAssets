<Project Sdk="Microsoft.NET.Sdk">

  <!-- PROJ-backed coordinate transformer of the network import pipeline. PROJ picks the most accurate available
       SAD69 → SIRGAS 2000 operation (the IBGE grid br_ibge_SAD69_003.tif when it is on the PROJ search path,
       a Helmert otherwise — 65.7 m vs 4.9 m vs reference near Salvador). Its GDAL bindings, native runtime and the one
       GdalBase.ConfigureAll() come from GeoAssets.Provider.Gdal, the single native GDAL boundary (ADR-002 D5,
       XD01-437): GdalEnvironment configures GDAL through GdalNativeInitializer. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Ingestion.Proj</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.Ingestion.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Ingestion\GeoAssets.Ingestion.csproj" />
    <ProjectReference Include="..\GeoAssets.Provider.Gdal\GeoAssets.Provider.Gdal.csproj" />
  </ItemGroup>

</Project>
