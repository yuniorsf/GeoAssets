<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Provider.FileGeodatabase</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Core\GeoAssets.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      XD01-225: the repo's first native/unmanaged dependency. ESRI File Geodatabase is a
      proprietary binary format with no pure-.NET writer; MaxRev.Gdal.Core bundles the official
      GDAL OGR bindings (OpenFileGDB driver has write support) plus the native GDAL binary for
      this project's target platforms. Scoped to this provider project only — GDAL/OGR types
      never appear in core/ (see IFileGeodatabaseExportService, the Core-owned boundary).
    -->
    <PackageReference Include="MaxRev.Gdal.Core" Version="3.13.3.611" />
    <PackageReference Include="MaxRev.Gdal.MacosRuntime.Minimal" Version="3.13.3.611" />
    <PackageReference Include="MaxRev.Gdal.LinuxRuntime.Minimal" Version="3.13.3.611" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

</Project>
