<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <!-- Real Postgres+PostGIS instance — RLS can only be verified against a real Postgres
         engine, and geo_entity's geometry column requires the postgis extension. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <!-- XD01-308: the selection endpoints are run end to end (TestServer over this suite's real
         PostgreSQL schema), which is the only place the HTTP layer, the selection service, the
         EF target store and the PostGIS spatial query meet. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- XD01-323: the "ServiceOrders"."RowVersion" contract is one source file, compiled into
         this suite (GeoAssets.Server's shared-database history) and into
         GeoAssets.FieldService.Server.Tests (the isolated FieldService history), so both
         histories are held to the same assertions. A link, not a project reference: neither
         suite can reference the other's host without loading two Program classes. -->
    <Compile Include="..\GeoAssets.FieldService.Server.Tests\ServiceOrderRowVersionContract.cs" Link="ServiceOrderRowVersionContract.cs" />
    <!-- XD01-379: the AddTargetLedgerVertical migration contract is likewise one body run against both histories. -->
    <Compile Include="..\GeoAssets.FieldService.Server.Tests\TargetLedgerMigrationContract.cs" Link="TargetLedgerMigrationContract.cs" />
    <!-- XD01-380: the NeutralOperator move (kernel RemoveOccupancyFromKernelModel + the AdoptOccupancyTables baseline) is likewise one body run against both histories. -->
    <Compile Include="..\GeoAssets.FieldService.Server.Tests\NeutralOperatorMigrationContract.cs" Link="NeutralOperatorMigrationContract.cs" />
    <!-- XD01-381: the FieldService move (kernel XD01-381 migration + the AdoptFieldServiceTables baseline) is likewise one body run against both histories. -->
    <Compile Include="..\GeoAssets.FieldService.Server.Tests\FieldServiceMigrationContract.cs" Link="FieldServiceMigrationContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- GeoAssetsDbContext (geo_entity) — its real migrations, including
         AddGeoEntityRowLevelSecurity/ForceGeoEntityRowLevelSecurity, live in this project. -->
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.PostgreSQL\GeoAssets.Provider.PostgreSQL.csproj" />
    <!-- ServiceOrderDbContext (ServiceOrders, ContractorUsLedgerEntries) is declared here, but
         its real migrations — AddServiceOrdersRowLevelSecurity,
         AddContractorUsLedgerEntriesRowLevelSecurity — live in GeoAssets.Server's
         MigrationsAssembly. Referencing it only loads types; its Program.cs top-level
         statements never execute unless something invokes the compiler-synthesized Main
         (confirmed precedent: GeoAssets.Server.Tests already references this same Exe-output
         project for the same reason). This suite deliberately applies the REAL migrations
         (Database.MigrateAsync()), not a hand-copied schema+policy, so a dropped or
         misconfigured RLS migration fails this suite loudly (XD01-204's AC) instead of being
         silently reapplied by the test itself. -->
    <ProjectReference Include="..\..\apps\GeoAssets.Server\GeoAssets.Server.csproj" />
    <!-- XD01-381: FieldServiceDbContext (the contractor US ledger, US catalog, postings, paving measurements and manhole
         audits in schema field_service) — the kernel chain no longer creates those tables, the vertical's own chain does. -->
    <ProjectReference Include="..\..\verticals\FieldService\GeoAssets.FieldService.Persistence\GeoAssets.FieldService.Persistence.csproj" />
    <!-- XD01-379: the ledger end-to-end suite builds the service over test doubles of the selection's spatial query. -->
    <ProjectReference Include="..\GeoAssets.Workflow.TestKit\GeoAssets.Workflow.TestKit.csproj" />
  </ItemGroup>

</Project>
