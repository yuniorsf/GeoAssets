<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <!-- Pins past an older EFCore version Microsoft.AspNetCore.TestHost's dependency graph
         otherwise resolves to, which conflicts (MSB3277) with the 10.0.7 the FieldService.Server
         ProjectReference brings in transitively via Npgsql.EntityFrameworkCore.PostgreSQL. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <!-- Microsoft.EntityFrameworkCore.Sqlite transitively pins SQLitePCLRaw 2.1.11, which has a
         known high-severity advisory (GHSA-2m69-gcr7-jv3q). Force the patched line directly. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.7" />
    <!-- XD01-386: boots the real Program.cs (WebApplicationFactory) to prove the host starts with no
         core asset database configured and resolves its asset-read ports to the GeoCore adapter. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <!-- Real Postgres instance for FieldServiceMigrationChainTests: the migration chain this
         host carries for ServiceOrderDbContext can only be executed against a real Postgres
         engine (every other test here builds its schema with SQLite's EnsureCreated, which
         runs no migration at all). Same version as the other Testcontainers suites. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\GeoAssets.FieldService.Server\GeoAssets.FieldService.Server.csproj" />
  </ItemGroup>

</Project>
