<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- XD01-378 (ADR-001 Phase 5): the IP-billing admin pages and components, out of the generic GeoAssets.Shared RCL. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.IpBilling.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\GeoAssets.Shared\GeoAssets.Shared.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.IpBilling\GeoAssets.IpBilling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Browser-only banned APIs (Console.Error shows Blazor's global error banner) — see BannedSymbols.Browser.txt. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\BannedSymbols.Browser.txt" Visible="false" />
  </ItemGroup>

</Project>
