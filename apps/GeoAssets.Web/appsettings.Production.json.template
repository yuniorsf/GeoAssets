{
  "AzureAdCiam": {
    "Authority": "${GEOASSETS_CIAM_AUTHORITY}",
    "ClientId": "${GEOASSETS_CIAM_CLIENT_ID}"
  },

  "GeoAssetsServer": {
    "BaseUrl": "${GEOASSETS_GATEWAY_URL}",
    "ApiScope": "${GEOASSETS_API_SCOPE}"
  },

  "Api": {
    "BaseUrl": "${GEOASSETS_GATEWAY_URL}/api/geoassets"
  },

  "GeoAssetsIpBillingServer": {
    "BaseUrl": "${GEOASSETS_IPBILLING_SERVER_URL}",
    "ApiScope": "${GEOASSETS_IPBILLING_API_SCOPE}"
  },

  "ServiceOrders": {
    "ApiBaseUrl": "${GEOASSETS_GATEWAY_URL}/api/workflow"
  },

  "Projects": {
    "ApiBaseUrl": "${GEOASSETS_GATEWAY_URL}/api/projects"
  },

  "Observability": {
    "AzureMonitor": {
      "ConnectionString": "${GEOASSETS_APPINSIGHTS_CONNECTION_STRING}"
    }
  }
}
