{
  "AzureAdCiam": {
    "Authority": "https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/YOUR_CIAM_TENANT_ID",
    "ClientId": "YOUR_WEB_CLIENT_ID",
    "ValidateAuthority": true,
    "PostLogoutRedirectUri": "authentication/logged-out"
  },

  "GeoAssetsServer": {
    "ApiScope": "api://YOUR_SERVER_API_CLIENT_ID/access_as_user",
    "RouteScopes": [
      { "PathPrefix": "/api/v/neutral-operator/", "Scope": "" }
    ]
  },

  "GeoAssetsIpBillingServer": {
    "_comment": "XD01-343: the IP-billing API's own scope (its registration, CIAM model (b)), e.g. api://<IpBilling API client id>/access_as_user — consented at sign-in. Blank = the IP-billing client requests GeoAssetsServer:ApiScope, for an IpBilling.Server whose AzureAdCiam:ClientId is the kernel's API (model (a)). See deploy/server/README.md.",
    "ApiScope": ""
  },

  "MapInterop": {
    "SinglePass": false,
    "BatchSize": 5,
    "RenderMode": "Canvas"
  },

  "Session": {
    "InactivityTimeoutMinutes": 30,
    "WarningBeforeTimeoutSeconds": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "GeoAssets": "Information",
      "GeoAssets.Shared.Components.Import.ImportExportPanel": "Debug"
    }
  },

  "Observability": {
    "ServiceName": "geoassets-web",
    "ServiceVersion": "1.0.0",
    "AzureMonitor": {
      "ConnectionString": ""
    },
   "Sampling": {
     "RatioForProduction": 0.25
    },
    "Instrumentation": {
      "EnableEFCore": true,
      "EnableRuntime": true,
      "EnableProcess": false,
      "RecordExceptionOnHttpErrors": true
    }
  }
}
