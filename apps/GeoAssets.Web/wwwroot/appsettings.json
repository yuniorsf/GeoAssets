{
  "AzureAdCiam": {
    "Authority": "https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/YOUR_CIAM_TENANT_ID",
    "ClientId": "YOUR_WEB_CLIENT_ID",
    "ValidateAuthority": true,
    "PostLogoutRedirectUri": "authentication/logged-out"
  },

  "GeoAssetsServer": {
    "ApiScope": "api://YOUR_SERVER_API_CLIENT_ID/access_as_user"
  },

  "MapInterop": {
    "SinglePass": false,
    "BatchSize": 5,
    "RenderMode": "Canvas"
  },

  "Session": {
    "InactivityTimeoutMinutes": 30,
    "WarningBeforeTimeoutSeconds": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "GeoAssets": "Information",
      "GeoAssets.Shared.Components.Import.ImportExportPanel": "Debug"
    }
  },

  "Observability": {
    "ServiceName": "geoassets-web",
    "ServiceVersion": "1.0.0",
    "AzureMonitor": {
      "ConnectionString": "YOUR_APPINSIGHTS_CONNECTION_STRING"
    },
   "Sampling": {
     "RatioForProduction": 0.25
    },
    "Instrumentation": {
      "EnableEFCore": true,
      "EnableRuntime": true,
      "EnableProcess": false,
      "RecordExceptionOnHttpErrors": true
    }
  }
}
