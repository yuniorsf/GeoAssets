{
  "AzureAdCiam": {
    "Authority": "https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/YOUR_CIAM_TENANT_ID",
    "ClientId": "YOUR_WEB_CLIENT_ID"
  },

  "GeoAssetsServer": {
    "ApiScope": "api://YOUR_SERVER_API_CLIENT_ID/access_as_user"
  },

  "GeoAssetsIpBillingServer": {
    "_comment": "XD01-343: the IP-billing API's own scope (its registration, CIAM model (b)), e.g. api://<IpBilling API client id>/access_as_user — consented at sign-in. Blank = the IP-billing client requests GeoAssetsServer:ApiScope, for an IpBilling.Server whose AzureAdCiam:ClientId is the kernel's API (model (a)). See deploy/server/README.md.",
    "ApiScope": ""
  },

  "Observability": {
    "AzureMonitor": {
      "ConnectionString": "InstrumentationKey=YOUR_INSTRUMENTATION_KEY;IngestionEndpoint=YOUR_INGESTION_ENDPOINT"
    }
  }
}
