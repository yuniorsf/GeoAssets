<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.Server</RootNamespace>
    <UserSecretsId>geoassets-server</UserSecretsId>
    <!-- NU1510 fires on the System.Security.Cryptography.Xml pin below: NuGet's pruning heuristic
         flags it as redundant for net10.0, but the pin is what overrides the vulnerable 10.0.10
         version pulled in transitively by Microsoft.Identity.Web.TokenCache (GHSA-7hqp-7c5m-4vq6,
         GHSA-c399-9853-6jmj) — removing it would silently revert to the vulnerable version. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1510</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <!-- The managed SkiaSharp package alone doesn't ship libSkiaSharp.so — without
         this, WmsEndpointExtensions' GetMap handler throws DllNotFoundException at
         runtime on Linux (e.g. the Docker image). NoDependencies avoids needing
         libfontconfig/libX11 etc. installed in the runtime image. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- App-only (client-credentials) Graph token acquisition for EntraGraphRoleAssignmentProvider
         (XD01-62) — already a transitive dependency of Microsoft.Identity.Web above; pinned
         explicitly here since this project calls into it directly. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <!-- AcsEmailInvitationSender (XD01-68) — sends the invite-only registration email via the
         Azure Communication Services Email resource provisioned per XD01-65. -->
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <!-- Pin past the vulnerable 10.0.10 pulled transitively by Microsoft.Identity.Web.TokenCache
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.PostgreSQL\GeoAssets.Provider.PostgreSQL.csproj" />
    <ProjectReference Include="..\GeoAssets.Identity.EFCore\GeoAssets.Identity.EFCore.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Core\GeoAssets.Core.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Workflow\GeoAssets.Workflow.csproj" />
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.EFCore\GeoAssets.Workflow.EFCore.csproj" />
    <ProjectReference Include="..\..\projects\GeoAssets.Projects.EFCore\GeoAssets.Projects.EFCore.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Infrastructure.Observability\GeoAssets.Infrastructure.Observability.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.IpBilling\GeoAssets.IpBilling.csproj" />
    <ProjectReference Include="..\..\ipbilling\GeoAssets.IpBilling.EFCore\GeoAssets.IpBilling.EFCore.csproj" />
  </ItemGroup>

</Project>
