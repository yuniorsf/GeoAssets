{
  "ConnectionStrings": {
    "GeoAssets": "Host=localhost;Port=5432;Database=geoassets;Username=postgres;Password=YOUR_PASSWORD_HERE"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5012",
      "https://localhost:7124"
    ]
  },
  "Observability": {
    "ServiceName": "geoassets-server",
    "ServiceVersion": "1.0.0",
    "Otlp": {
      "Endpoint": "https://otlp.nr-data.net:4317",
      "Protocol": "Grpc"
    },
    "Sampling": { "RatioForProduction": 1.0 },
    "Instrumentation": { "EnableEFCore": true, "EnableRuntime": true }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
