<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Same rationale as Platforms/iOS/Info.plist (XD01-52) — MacCatalyst is a separate TFM/bundle
     from iOS despite sharing most iOS APIs, so it needs its own CFBundleURLTypes registration for
     MSAL.NET's "msauth.com.geoassets.app" redirect scheme (bundle ID from ApplicationId). -->
<plist version="1.0">
<dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.geoassets.app.msal</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.com.geoassets.app</string>
			</array>
		</dict>
	</array>
	<!-- Same rationale as Platforms/iOS/Info.plist (XD01-244). -->
	<key>NSCameraUsageDescription</key>
	<string>GeoAssets uses the camera to capture signed field-work evidence photos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>GeoAssets uses your location to geotag field-work evidence photos.</string>
	<!-- XD01-461: the UIScene life cycle — apps built with the 27 SDKs fail to launch without it. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
					<key>UISceneDelegateClassName</key>
					<string>SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
