<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GeoAssets.MAUI"
             x:Class="GeoAssets.MAUI.MainPage">

    <local:HostPageBlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <local:HostPageBlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type local:WebApp}" />
        </local:HostPageBlazorWebView.RootComponents>
    </local:HostPageBlazorWebView>

</ContentPage>
