<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- XD01-293: Oracle opt-out knob for an uncoded, SDK-internal MacDev build warning under
         /warnaserror — not a toggle for ordinary builds, which always include both Apple TFMs. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) AND '$(GeoAssetsOracleSkipAppleTfms)' != 'true'">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- XD01-461: an app, not a library — without it no .apk/.app is produced and nothing can be launched. Windows
         stays a library: it has no Platforms/Windows entry point, and its TFM builds only on Windows. -->
    <OutputType Condition="!$(TargetFramework.Contains('-windows'))">Exe</OutputType>
    <!-- XD01-461: the installed .NET for iOS/Mac Catalyst workload (26.4) refuses a newer Xcode than its own (27.x
         here) for an app build; the app builds and launches with it. Pass -p:ValidateXcodeVersion=true to check. -->
    <ValidateXcodeVersion Condition="'$(ValidateXcodeVersion)' == ''">false</ValidateXcodeVersion>
    <RootNamespace>GeoAssets.MAUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <EnableWindowsTargeting Condition="$([MSBuild]::IsOSPlatform('windows'))">true</EnableWindowsTargeting>

    <!-- App Info -->
    <ApplicationTitle>GeoAssets</ApplicationTitle>
    <ApplicationId>com.geoassets.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.51" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.51" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
    <!-- MSAL.NET public-client interactive/silent token acquisition (XD01-52) — version pinned
         to match apps/GeoAssets.Server/GeoAssets.Server.csproj's existing reference. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <!-- Watermark burn-in for field-work evidence photos (XD01-244) — version pinned to match
         apps/GeoAssets.Server/GeoAssets.Server.csproj's existing reference. -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <!-- On-device barcode/QR decoding for FTTH tag/ONT label scanning (XD01-275) — the pure,
         platform-agnostic ZXing.Net decode engine (BarcodeReaderGeneric + RGBLuminanceSource)
         fed from a MediaPicker-captured still photo decoded via the SkiaSharp reference above,
         rather than ZXing.Net.Maui.Controls' live-camera-preview XAML control — avoids pulling
         in a second, less mature per-platform handler/view package on top of SkiaSharp, and
         reuses the exact capture pattern MauiEvidenceCaptureGateway (XD01-244) already does. -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- XD01-461: Magick.NET comes in through GeoAssets.Core (for NeutralOperator's FieldPhotoWatermarker) and has no
         Android runtime; without this its linux-x64 library is packed into the APK (XA0141), where it can never load. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" ExcludeAssets="native" Condition="$(TargetFramework.Contains('-android'))" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Existing properties -->
    <AndroidMinSdkVersion>23</AndroidMinSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoAssets.Shared\GeoAssets.Shared.csproj" />
    <ProjectReference Include="..\..\verticals\NeutralOperator\GeoAssets.NeutralOperator.UI\GeoAssets.NeutralOperator.UI.csproj" />
    <ProjectReference Include="..\..\verticals\NeutralOperator\GeoAssets.NeutralOperator.Rest\GeoAssets.NeutralOperator.Rest.csproj" />
    <ProjectReference Include="..\..\ipbilling\GeoAssets.IpBilling.UI\GeoAssets.IpBilling.UI.csproj" />
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.Rest\GeoAssets.Provider.Rest.csproj" />
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.PMTiles\GeoAssets.Provider.PMTiles.csproj" />
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.Rest\GeoAssets.Workflow.Rest.csproj" />
  </ItemGroup>

  <!-- Read only as the embedded resource below (MauiProgram.cs). The Razor SDK's default globbing
       also adds it as Content, which the Apple bundlers reject as a file outside the app bundle. -->
  <ItemGroup>
    <Content Remove="appsettings.json" />
    <EmbeddedResource Include="appsettings.json">
      <LogicalName>GeoAssets.MAUI.appsettings.json</LogicalName>
      <Pack>false</Pack>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Static web assets from Shared RCL -->
  <ItemGroup>
    <MauiAsset Include="wwwroot\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Explicitly import the StaticWebAssets SDK so that StaticWebAssetsPrepareForRun,
       StaticWebAssetsPrepareForPublish and LoadStaticWebAssetsPublishManifest are defined
       for every TFM (including net9.0-android where the Razor SDK skips this import).
       All task-based work in the SDK is guarded by StaticWebAssetsSdkBuildTasksAssembly
       so it is a safe no-op when the tasks assembly is absent on mobile platforms. -->
  <Sdk Name="Microsoft.NET.Sdk.StaticWebAssets" />

</Project>
