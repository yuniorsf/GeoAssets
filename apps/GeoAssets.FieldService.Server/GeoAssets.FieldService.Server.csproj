<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.FieldService.Server</RootNamespace>
    <UserSecretsId>geoassets-fieldservice-server</UserSecretsId>
    <!-- NU1510 fires on the System.Security.Cryptography.Xml pin below — same pre-existing
         NuGet pruning-heuristic false positive as GeoAssets.Server.csproj. The actual fix for
         `dotnet build GeoAssets.sln /warnaserror` (XD01-294) is the NoWarn="NU1510" item
         metadata on the PackageReference itself, below — this property alone doesn't cover
         the solution-wide restore-time diagnostic. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1510</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.FieldService.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- OpenAPI contract (XD01-207 AC) — built-in document generator, no Swashbuckle needed. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- Pin past the vulnerable 2.0.0 pulled transitively by Microsoft.AspNetCore.OpenApi
         (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- Pin past the vulnerable 10.0.10 pulled transitively by Microsoft.Identity.Web.TokenCache
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj) —
         same pin as GeoAssets.Server.csproj. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Core\GeoAssets.Core.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Identity\GeoAssets.Identity.csproj" />
    <!-- Archetype domain assemblies (XD01-212) — each stays independent of the others and of
         GeoAssets.Workflow (see each one's own csproj doc comment); this host is where they get
         composed, not where that independence is relaxed. -->
    <ProjectReference Include="..\..\core\GeoAssets.Domain.Electrical\GeoAssets.Domain.Electrical.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Domain.Sanitation\GeoAssets.Domain.Sanitation.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Domain.NeutralPole\GeoAssets.Domain.NeutralPole.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Workflow\GeoAssets.Workflow.csproj" />
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.EFCore\GeoAssets.Workflow.EFCore.csproj" />
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.PostgreSQL\GeoAssets.Provider.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Infrastructure.Observability\GeoAssets.Infrastructure.Observability.csproj" />
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.Messaging.Protobuf\GeoAssets.Workflow.Messaging.Protobuf.csproj" />
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.Rest\GeoAssets.Provider.Rest.csproj" />
    <!-- Concessionaire compliance dossier exporter (XD01-284) needs IShapefileExportService's
         concrete implementation for the DIS-NOR-056 Shapefile half. -->
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.Shapefile\GeoAssets.Provider.Shapefile.csproj" />
    <!-- ANEEL BDGD File Geodatabase export (XD01-225) needs IFileGeodatabaseExportService's
         GDAL-backed concrete implementation. -->
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.FileGeodatabase\GeoAssets.Provider.FileGeodatabase.csproj" />
  </ItemGroup>

</Project>
