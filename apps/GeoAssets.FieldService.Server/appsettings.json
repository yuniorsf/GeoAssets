{
  "ConnectionStrings": {
    "GeoAssets": "Host=localhost;Port=5432;Database=geoassets;Username=postgres;Password=YOUR_PASSWORD_HERE"
  },
  "GeoCoreServer": {
    "BaseUrl": "https://localhost:5081/api/geoassets"
  },
  "AzureAdCiam": {
    "Instance": "https://YOUR_TENANT_SUBDOMAIN.ciamlogin.com/",
    "TenantId": "YOUR_CIAM_TENANT_ID",
    "ClientId": "YOUR_FIELDSERVICE_API_CLIENT_ID"
  },
  "Postgres": {
    "_comment": "StatementTimeoutMs is unset by default (XD01-214) — set it to cap how long any single statement on this connection string may run, a server-side 'noisy neighbor' backstop for the shared tier.",
    "StatementTimeoutMs": null
  },
  "Observability": {
    "ServiceName": "geoassets-fieldservice-server",
    "ServiceVersion": "1.0.0",
    "Otlp": {
      "Endpoint": "https://otlp.nr-data.net:4317",
      "Protocol": "Grpc"
    },
    "Instrumentation": { "EnableEFCore": true, "EnableRuntime": true }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
