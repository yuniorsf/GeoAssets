@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Core.Interfaces
@implements IDisposable
@inject IAssetProvider Repository
@inject IFeatureSelectionState Selection

<div class="sidebar-section">
    <h6>@L["assets.title"] (@_filtered.Count)</h6>
    <SearchBar Query="@_searchQuery" OnSearch="OnSearch" />
</div>

<div class="sidebar-section">
    <select class="form-control" style="font-size:0.82rem" @onchange="OnTypeFilter">
        <option value="">@L["assets.allTypes"]</option>
        @foreach (var t in Repository.GetAssetTypes())
        {
            <option value="@t.Id">@t.Name</option>
        }
    </select>
</div>

<div>
    @if (_filtered.Count == 0)
    {
        <div class="empty-state">
            <p>@L["assets.empty"]</p>
        </div>
    }
    else
    {
        <div class="asset-list">
            @foreach (var feature in _filtered)
            {
                var color = GetColor(feature.Properties.AssetTypeId);
                <div class="asset-list-item @(Selection.Selected?.Id == feature.Id ? "selected" : "")"
                     @onclick="() => SelectFeature(feature)">
                    <span class="asset-color-dot" style="background:@color"></span>
                    <span class="asset-name">@(string.IsNullOrEmpty(feature.Properties.Name) ? L["assets.noName"] : feature.Properties.Name)</span>
                    <span class="asset-geom-icon">@GeometryIcon(feature)</span>
                    <button class="btn-icon" title="@L["assets.delete"]"
                            @onclick:stopPropagation="true"
                            @onclick="() => RequestDelete(feature)">🗑</button>
                </div>
            }
        </div>
    }
</div>

<ConfirmDialog Visible="_deleteConfirmVisible"
               Title="@L["assets.deleteTitle"]"
               Message="@L.GetString("assets.deleteConfirm", _pendingDelete?.Properties.Name ?? L["assets.noName"])"
               ConfirmLabel="@L["assets.delete"]"
               OnConfirm="ConfirmDelete"
               OnCancel="CancelDelete" />
