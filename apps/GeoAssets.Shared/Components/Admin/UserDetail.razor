@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Identity.Authorization.Repositories
@inject IUserRepository Repository
@inject IRoleRepository RoleRepository
@inject IServiceProvider ServiceProvider

@if (User is not null)
{
    <div>
        <h5>@L["admin.users.editTitle"]</h5>

        <div class="form-group">
            <label>@L["admin.users.email"]</label>
            <input class="form-control" readonly value="@User.Email" />
        </div>

        <EditForm Model="@User" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>@L["admin.users.displayName"]</label>
                <InputText class="form-control" @bind-Value="User.DisplayName" />
            </div>

            <div class="form-group">
                <label style="display:flex;align-items:center;gap:6px">
                    <InputCheckbox @bind-Value="User.IsActive" />
                    @L["admin.users.isActive"]
                </label>
            </div>

            <div class="form-group">
                <label>@L["admin.users.organizationId"]</label>
                <input class="form-control" @bind="_organizationIdText"
                       placeholder="@L["admin.users.organizationIdPlaceholder"]" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="attribute-errors">@_error</p>
            }

            <div class="form-actions">
                <button class="btn btn-primary" type="submit">@L["assets.save"]</button>
                <button class="btn btn-secondary" type="button" @onclick="Cancel">@L["assets.cancel"]</button>
            </div>
        </EditForm>

        @if (_roleSyncEnabled)
        {
            <div class="permission-group">
                <h6>@L["admin.users.entraRoles"]</h6>
                @foreach (var role in _allRoles)
                {
                    <label class="permission-toggle">
                        <input type="checkbox"
                               checked="@_assignedRoleNames.Contains(role.Name)"
                               disabled="@(_togglingRoleId == role.Id)"
                               @onchange="ev => ToggleRoleAsync(role, (bool)ev.Value!)" />
                        <span>@role.Name</span>
                    </label>
                }
            </div>
        }
    </div>
}
