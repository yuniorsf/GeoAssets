@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Identity.Authorization.Repositories
@inject IUserRepository Repository
@inject IRoleRepository RoleRepository
@inject IOrganizationRepository OrganizationRepository
@inject IServiceProvider ServiceProvider

@if (User is not null)
{
    <div>
        <h5>@L["admin.users.editTitle"]</h5>

        <div class="form-group">
            <label>@L["admin.users.email"]</label>
            <input class="form-control" readonly value="@User.Email" />
        </div>

        <EditForm Model="@User" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>@L["admin.users.displayName"]</label>
                <InputText class="form-control" @bind-Value="User.DisplayName" />
            </div>

            <div class="form-group">
                <label style="display:flex;align-items:center;gap:6px">
                    <InputCheckbox @bind-Value="User.IsActive" />
                    @L["admin.users.isActive"]
                </label>
            </div>

            <div class="form-group">
                <label>@L["admin.users.organizationId"]</label>
                <select class="form-control" @onchange="OnOrganizationChanged">
                    <option value="" selected="@(User.OrganizationId is null)">@L["admin.users.organizationNone"]</option>
                    @foreach (var organization in _organizations)
                    {
                        <option value="@organization.Id" selected="@(User.OrganizationId == organization.Id)">@organization.Name</option>
                    }
                </select>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit">@L["assets.save"]</button>
                <button class="btn btn-secondary" type="button" @onclick="Cancel">@L["assets.cancel"]</button>
            </div>
        </EditForm>

        @if (_roleSyncEnabled)
        {
            <div class="permission-group">
                <h6>@L["admin.users.entraRoles"]</h6>
                @foreach (var role in _allRoles)
                {
                    <label class="permission-toggle">
                        <input type="checkbox"
                               checked="@_assignedRoleNames.Contains(role.Name)"
                               disabled="@(_togglingRoleId == role.Id)"
                               @onchange="ev => ToggleRoleAsync(role, (bool)ev.Value!)" />
                        <span>@role.Name</span>
                    </label>
                }
            </div>
        }

        @if (_scopedRolesAvailable)
        {
            <div class="permission-group user-scoped-roles">
                <h6>@L["admin.contractorAccess.userRoles.title"]</h6>
                <p class="text-body-secondary small mb-1">@L["admin.contractorAccess.userRoles.hint"]</p>
                @if (_scopedRolesFailed)
                {
                    <p class="attribute-errors">@L["admin.contractorAccess.userRoles.loadError"]</p>
                }
                else if (_scopedRoles.Count == 0)
                {
                    <p class="text-body-secondary small user-scoped-roles-empty">@L["admin.contractorAccess.userRoles.empty"]</p>
                }
                else
                {
                    <ul class="list-unstyled small mb-0">
                        @foreach (var assignment in _scopedRoles)
                        {
                            <li class="user-scoped-role"><strong>@(assignment.OrganizationName ?? assignment.OrganizationId.ToString())</strong> — @assignment.RoleName</li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
}
