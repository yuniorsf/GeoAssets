@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Identity.Authorization.Repositories
@inject IRoleRepository RoleRepository
@inject IPermissionRepository PermissionRepository
@inject IServiceProvider ServiceProvider

@if (_loading)
{
    <div class="empty-state"><p>@L["app.loading"]</p></div>
}
else
{
    <div>
        <h5>
            @(IsNew ? L["admin.roles.newRole"] : L["admin.roles.editTitle"])
            @if (!IsNew && _role is { IsBuiltIn: true })
            {
                <span class="badge-builtin">@L["admin.roles.builtIn"]</span>
            }
        </h5>

        <EditForm Model="@_editModel" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>@L["admin.roles.name"]</label>
                <InputText class="form-control" @bind-Value="_editModel.Name" />
            </div>

            <div class="form-group">
                <label>@L["admin.roles.description"]</label>
                <InputTextArea class="form-control" @bind-Value="_editModel.Description" rows="2" />
            </div>

            <div class="form-group">
                <label>@L["admin.roles.permissions"]</label>
                @if (IsNew)
                {
                    <p class="empty-state">@L["admin.roles.savePermissionsHint"]</p>
                }
                else
                {
                    @foreach (var group in _allPermissions.GroupBy(p => p.Resource).OrderBy(g => g.Key))
                    {
                        <div class="permission-group">
                            <h6>@group.Key</h6>
                            @foreach (var permission in group.OrderBy(p => p.Action))
                            {
                                <label class="permission-toggle">
                                    <input type="checkbox"
                                           checked="@_grantedPermissionIds.Contains(permission.Id)"
                                           disabled="@_togglingPermissionId.HasValue"
                                           @onchange="ev => TogglePermissionAsync(permission, (bool)ev.Value!)" />
                                    <span>@permission.Code</span>
                                </label>
                            }
                        </div>
                    }
                }
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="attribute-errors">@_error</p>
            }
            @if (!string.IsNullOrEmpty(_registerSuccessMessage))
            {
                <p class="attribute-success">@_registerSuccessMessage</p>
            }

            <div class="form-actions">
                <button class="btn btn-primary" type="submit">@L["assets.save"]</button>
                <button class="btn btn-secondary" type="button" @onclick="Cancel">@L["assets.cancel"]</button>
                @if (!IsNew && _roleSyncEnabled)
                {
                    <button class="btn btn-secondary" type="button" @onclick="RegisterInEntraAsync" disabled="@_registeringInEntra">
                        @(_registeringInEntra ? L["admin.roles.registering"] : L["admin.roles.registerInEntra"])
                    </button>
                }
                @if (!IsNew && _role is { IsBuiltIn: false })
                {
                    <button class="btn btn-danger" type="button" @onclick="RequestDelete">@L["assets.delete"]</button>
                }
            </div>
        </EditForm>
    </div>
}

<ConfirmDialog Visible="_showDeleteConfirm"
               Title="@L["admin.roles.deleteTitle"]"
               Message="@L.GetString("admin.roles.deleteConfirm", _role?.Name ?? string.Empty)"
               ConfirmLabel="@L["assets.delete"]"
               OnConfirm="ConfirmDelete"
               OnCancel="() => _showDeleteConfirm = false" />
