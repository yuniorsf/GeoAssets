@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase

@if (Visible)
{
    <div class="map-context-menu-backdrop" @onclick="HandleClose"></div>
    <div class="map-context-menu" style="left: @(X)px; top: @(Y)px" @onclick:stopPropagation="true">
        <button class="ctx-item" @onclick="HandleEdit">
            <span class="ctx-icon">✏️</span> @L["assets.properties"]
        </button>
        @if (ShowSave)
        {
            <button class="ctx-item" @onclick="HandleSave">
                <span class="ctx-icon">💾</span> @L["assets.save"]
            </button>
        }
        <div class="ctx-separator"></div>
        <button class="ctx-item ctx-danger" @onclick="HandleDelete">
            <span class="ctx-icon">🗑️</span> @L["assets.delete"]
        </button>
    </div>
}
