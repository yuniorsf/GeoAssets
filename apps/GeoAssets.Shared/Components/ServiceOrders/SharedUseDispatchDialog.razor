@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Shared.Services.Occupancy
@using GeoAssets.Shared.Services.SharedUse
@using GeoAssets.NeutralOperator.Application.SharedUse
@inject ISharedUseDispatchPlanReader Plans
@inject ISharedUseDispatchService Dispatcher

@if (Visible)
{
    <div class="dialog-backdrop" @onclick="Cancel">
        <div class="dialog-box shared-use-dialog" role="dialog" aria-modal="true" aria-labelledby="shared-use-dialog-title"
             @onclick:stopPropagation="true">
            <h6 id="shared-use-dialog-title">@L["sharedUse.dispatch.title"]</h6>
            <p class="shared-use-intro">@L["sharedUse.dispatch.intro"]</p>

            @if (_errorKey is not null)
            {
                <p class="shared-use-notice shared-use-notice-error" role="alert">@L[_errorKey]</p>
            }

            @if (_result is not null)
            {
                <p class="shared-use-notice shared-use-notice-success" role="status">
                    @L.GetString("sharedUse.dispatch.result", _result.ChildOrdersCreated, _result.ChildOrdersAlreadyDispatched)
                </p>
            }

            @if (_preview is null)
            {
                @if (_loading)
                {
                    <p class="empty-state" role="status">@L["sharedUse.dispatch.loading"]</p>
                }
            }
            else
            {
                <dl class="shared-use-summary">
                    <div><dt>@L["sharedUse.summary.poles"]</dt><dd>@_preview.TargetCount</dd></div>
                    <div><dt>@L["sharedUse.summary.recipients"]</dt><dd>@_preview.Recipients.TotalCount</dd></div>
                    <div><dt>@L["sharedUse.summary.newOrders"]</dt><dd>@_preview.NewRecipientCount</dd></div>
                </dl>

                @if (_preview.BlockReason is { } reason)
                {
                    <p class="shared-use-notice shared-use-notice-error" role="alert">
                        @L.GetString(SharedUseDispatchMessages.BlockKey(reason), _preview.TargetsWithoutActivityCount)
                    </p>
                }
                else if (SharedUseDispatchDialogState.HasNothingNew(_preview) && _result is null)
                {
                    <p class="shared-use-notice" role="status">@L["sharedUse.dispatch.nothingNew"]</p>
                }

                @if (Caveats.Count > 0)
                {
                    <ul class="shared-use-caveats">
                        @foreach (var caveat in Caveats)
                        {
                            <li>@L.GetString(caveat.MessageKey, caveat.Count)</li>
                        }
                    </ul>
                }

                @if (_preview.Recipients.TotalCount > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle shared-use-table">
                            <caption>@L["sharedUse.recipients.caption"]</caption>
                            <thead>
                                <tr>
                                    <th scope="col">@L["sharedUse.recipients.organization"]</th>
                                    <th scope="col" class="text-end">@L["sharedUse.recipients.poles"]</th>
                                    <th scope="col">@L["sharedUse.recipients.state"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var recipient in _preview.Recipients.Items)
                                {
                                    <tr @key="recipient.ChildOrderId">
                                        <th scope="row" class="shared-use-organization">@recipient.OccupantOrganizationId</th>
                                        <td class="text-end">@recipient.PoleCount</td>
                                        <td>
                                            @if (recipient.AlreadyDispatched)
                                            {
                                                <span class="shared-use-badge shared-use-badge-muted">@L["sharedUse.recipients.dispatched"]</span>
                                            }
                                            else
                                            {
                                                <span class="shared-use-badge shared-use-badge-accent">@L["sharedUse.recipients.new"]</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="assets-table-pager">
                        <span class="assets-table-pager-summary" aria-live="polite">@RecipientsSummary()</span>
                        <nav aria-label="@L["sharedUse.recipients.pager"]">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(CanGoToPreviousRecipients ? "" : "disabled")">
                                    <button type="button" class="page-link" disabled="@(!CanGoToPreviousRecipients)"
                                            @onclick="() => GoToRecipientsAsync(_page - 1)">@L["assetsTable.previous"]</button>
                                </li>
                                <li class="page-item @(CanGoToNextRecipients ? "" : "disabled")">
                                    <button type="button" class="page-link" disabled="@(!CanGoToNextRecipients)"
                                            @onclick="() => GoToRecipientsAsync(_page + 1)">@L["assetsTable.next"]</button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }

                @if (_preview.SkippedEntryCount > 0)
                {
                    <button type="button" class="btn btn-outline btn-sm shared-use-toggle"
                            aria-expanded="@(_skippedOpen ? "true" : "false")" aria-controls="shared-use-skipped"
                            @onclick="ToggleSkippedAsync">
                        @L[_skippedOpen ? "sharedUse.skipped.hide" : "sharedUse.skipped.show"]
                    </button>

                    <div id="shared-use-skipped" hidden="@(!_skippedOpen)">
                        @if (_skippedFailed)
                        {
                            <p class="shared-use-notice shared-use-notice-error" role="alert">@L["sharedUse.skipped.loadError"]</p>
                        }
                        else if (_skipped is not null)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle shared-use-table">
                                    <caption>@L["sharedUse.skipped.caption"]</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">@L["sharedUse.skipped.pole"]</th>
                                            <th scope="col">@L["sharedUse.skipped.slot"]</th>
                                            <th scope="col">@L["sharedUse.skipped.status"]</th>
                                            <th scope="col">@L["sharedUse.skipped.reason"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in _skipped)
                                        {
                                            <tr @key="entry.EntryId">
                                                <th scope="row">@entry.PoleFeatureId</th>
                                                <td>@(entry.SlotIndex is { } slot ? slot.ToString(System.Globalization.CultureInfo.CurrentCulture) : L["sharedUse.skipped.beyondSlots"])</td>
                                                <td>@L[OccupancyEditorMessages.StatusKey(entry.Status)]</td>
                                                <td>@L[SharedUseDispatchMessages.SkipReasonKey(entry.Reason)]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="assets-table-pager">
                                <span class="assets-table-pager-summary" aria-live="polite">@SkippedSummary()</span>
                                <nav aria-label="@L["sharedUse.skipped.pager"]">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(CanGoToPreviousSkipped ? "" : "disabled")">
                                            <button type="button" class="page-link" disabled="@(!CanGoToPreviousSkipped)"
                                                    @onclick="() => GoToSkippedAsync(_skippedPage - 1)">@L["assetsTable.previous"]</button>
                                        </li>
                                        <li class="page-item @(CanGoToNextSkipped ? "" : "disabled")">
                                            <button type="button" class="page-link" disabled="@(!CanGoToNextSkipped)"
                                                    @onclick="() => GoToSkippedAsync(_skippedPage + 1)">@L["assetsTable.next"]</button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                        else
                        {
                            <p class="empty-state" role="status">@L["sharedUse.dispatch.loading"]</p>
                        }
                    </div>
                }
            }

            <div class="dialog-actions">
                <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel">
                    @L[_result is null ? "assets.cancel" : "sharedUse.dispatch.close"]
                </button>
                <button type="button" class="btn btn-primary btn-sm" disabled="@(!CanConfirm)" aria-busy="@(_busy ? "true" : "false")"
                        @onclick="ConfirmAsync">
                    @(_busy ? L["sharedUse.dispatch.dispatching"] : L.GetString("sharedUse.dispatch.confirm", _preview?.NewRecipientCount ?? 0))
                </button>
            </div>
        </div>
    </div>
}
