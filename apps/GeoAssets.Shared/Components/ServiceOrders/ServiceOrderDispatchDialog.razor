@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Workflow.Orders

@if (Visible)
{
    <div class="dialog-backdrop" @onclick="Cancel">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <h6>@L["orders.dispatchTitle"]</h6>

            <div class="form-group">
                <label>@L["orders.dispatchTargetType"]</label>
                <select class="form-control" @bind="_targetType">
                    @foreach (var type in Enum.GetValues<DispatchTargetType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>@L["orders.dispatchTargetId"]</label>
                <input class="form-control" @bind="_targetId" placeholder="@L["orders.dispatchTargetIdPlaceholder"]" />
            </div>

            <div class="form-group">
                <label>@L["orders.dispatchNote"]</label>
                <textarea class="form-control" rows="2" @bind="_note"></textarea>
            </div>

            <div class="dialog-actions">
                <button class="btn btn-secondary btn-sm" @onclick="Cancel">@L["assets.cancel"]</button>
                <button class="btn btn-primary btn-sm" disabled="@string.IsNullOrWhiteSpace(_targetId)" @onclick="Confirm">@L["orders.dispatch"]</button>
            </div>
        </div>
    </div>
}
