@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Workflow.Orders
@using GeoAssets.Shared.Components.Shared
@inject IServiceOrderRepository Repository

<div class="sidebar-section">
    <h6>@L["orders.title"] (@_filtered.Count)</h6>
    <SearchBar Query="@_searchQuery" OnSearch="OnSearch" />
</div>

<div class="sidebar-section">
    <select class="form-control" style="font-size:0.82rem" @onchange="OnStatusFilter">
        <option value="">@L["orders.allStatuses"]</option>
        @foreach (var status in _statuses)
        {
            <option value="@status">@status</option>
        }
    </select>
    <button class="btn btn-primary btn-sm order-new-btn" @onclick="RequestCreate">@L["orders.newOrder"]</button>
</div>

<div class="sidebar-scrollable">
    @if (_filtered.Count == 0)
    {
        <div class="empty-state">
            <p>@L["orders.empty"]</p>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in _filtered)
            {
                <div class="order-list-item @(SelectedOrderId == order.Id ? "selected" : "")"
                     @onclick="() => SelectOrder(order)">
                    <span class="order-status-dot order-status-@order.Status.ToString().ToLowerInvariant()"></span>
                    <span class="order-name">@order.Title</span>
                    <span class="order-priority-badge order-priority-@order.Priority.ToString().ToLowerInvariant()">@order.Priority</span>
                </div>
            }
        </div>
    }
</div>
