@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Workflow.Orders
@using GeoAssets.Workflow.Rules
@inject IServiceOrderRepository Repository
@inject OrderTypeRegistry OrderTypes
@inject ServiceOrderRules Rules

<div>
    <h5>@L["orders.newOrder"]</h5>

    @if (_allowedTypes.Count == 0)
    {
        <p class="empty-state">@L["orders.noCreatableTypes"]</p>
    }
    else
    {
        <EditForm Model="@_model" OnValidSubmit="HandleSave">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label>@L["orders.orderTitle"]</label>
                <InputText class="form-control" @bind-Value="_model.Title" placeholder="@L["orders.orderTitlePlaceholder"]" />
            </div>

            <div class="form-group">
                <label>@L["assets.description"]</label>
                <InputTextArea class="form-control" @bind-Value="_model.Description" rows="3" />
            </div>

            <div class="form-group">
                <label>@L["orders.orderType"]</label>
                <InputSelect class="form-control" @bind-Value="_model.OrderTypeId">
                    @foreach (var type in _allowedTypes)
                    {
                        <option value="@type.Id">@type.DisplayName</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>@L["orders.priority"]</label>
                <InputSelect class="form-control" @bind-Value="_model.Priority">
                    @foreach (var priority in Enum.GetValues<ServiceOrderPriority>())
                    {
                        <option value="@priority">@priority</option>
                    }
                </InputSelect>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit">@L["assets.save"]</button>
                <button class="btn btn-secondary" type="button" @onclick="Cancel">@L["assets.cancel"]</button>
            </div>
        </EditForm>
    }
</div>
