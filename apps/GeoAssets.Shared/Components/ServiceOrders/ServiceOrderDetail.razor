@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.Workflow.Orders
@using GeoAssets.Workflow.Rules
@inject IServiceOrderRepository Repository
@inject ServiceOrderRules Rules
@inject OrderTypeRegistry OrderTypes

@if (Order is not null)
{
    <div class="order-detail">
        <div class="order-detail-header">
            <h5>@Order.Title</h5>
            <button class="btn-icon" title="@L["assets.cancel"]" @onclick="Close">✕</button>
        </div>

        <div class="order-detail-meta">
            <span class="order-status-dot order-status-@Order.Status.ToString().ToLowerInvariant()"></span>
            <span>@Order.Status</span>
            <span class="order-priority-badge order-priority-@Order.Priority.ToString().ToLowerInvariant()">@Order.Priority</span>
            <span class="order-type-badge">@(OrderTypes.Find(Order.OrderTypeId)?.DisplayName ?? Order.OrderTypeId)</span>
        </div>

        @if (!string.IsNullOrEmpty(Order.Description))
        {
            <p class="order-detail-description">@Order.Description</p>
        }

        <div class="order-detail-fields">
            <div><label>@L["orders.createdBy"]</label><span>@Order.CreatedBy</span></div>
            <div><label>@L["orders.assignedTo"]</label><span>@(Order.AssignedTo ?? "—")</span></div>
            <div><label>@L["orders.createdAt"]</label><span>@Order.CreatedAt.ToLocalTime()</span></div>
            @if (Order.UpdatedAt is not null)
            {
                <div><label>@L["orders.updatedAt"]</label><span>@Order.UpdatedAt.Value.ToLocalTime()</span></div>
            }
        </div>

        <div class="order-actions">
            @if (CanDispatch)
            {
                <button class="btn btn-outline btn-sm" @onclick="OpenDispatchDialog">@L["orders.dispatch"]</button>
            }
            @if (CanAssignToMe)
            {
                <button class="btn btn-outline btn-sm" @onclick="AssignToMe">@L["orders.assignToMe"]</button>
            }
            @if (CanStart)
            {
                <button class="btn btn-primary btn-sm" @onclick="Start">@L["orders.start"]</button>
            }
            @if (CanComplete)
            {
                <button class="btn btn-primary btn-sm" @onclick="Complete">@L["orders.complete"]</button>
            }
            @if (CanCancel)
            {
                <button class="btn btn-danger btn-sm" @onclick="CancelOrder">@L["assets.cancel"]</button>
            }
        </div>

        @if (CanAnnotate)
        {
            <div class="order-annotate">
                <textarea class="form-control" rows="2" placeholder="@L["orders.annotatePlaceholder"]" @bind="_noteText"></textarea>
                <button class="btn btn-secondary btn-sm" disabled="@string.IsNullOrWhiteSpace(_noteText)" @onclick="AddAnnotation">@L["orders.addNote"]</button>
            </div>
        }

        <h6 class="order-section-title">@L["orders.dispatchHistory"]</h6>
        @if (Order.Dispatches.Count == 0)
        {
            <p class="empty-state">@L["orders.noDispatches"]</p>
        }
        else
        {
            <ul class="order-timeline">
                @foreach (var dispatch in Order.Dispatches.OrderByDescending(d => d.DispatchedAt))
                {
                    <li>
                        <strong>@dispatch.TargetType</strong> → @dispatch.TargetId
                        <span class="order-timeline-meta">@dispatch.DispatchedAt.ToLocalTime() — @dispatch.DispatchedBy</span>
                        @if (!string.IsNullOrEmpty(dispatch.Note))
                        {
                            <div class="order-timeline-note">@dispatch.Note</div>
                        }
                    </li>
                }
            </ul>
        }

        <h6 class="order-section-title">@L["orders.actionLog"]</h6>
        @if (Order.ActionLog.Count == 0)
        {
            <p class="empty-state">@L["orders.noActions"]</p>
        }
        else
        {
            <ul class="order-timeline">
                @foreach (var entry in Order.ActionLog.OrderByDescending(a => a.PerformedAt))
                {
                    <li>
                        <strong>@entry.Action</strong>
                        <span class="order-timeline-meta">@entry.PerformedAt.ToLocalTime() — @entry.PerformedBy</span>
                        @if (!string.IsNullOrEmpty(entry.Comment))
                        {
                            <div class="order-timeline-note">@entry.Comment</div>
                        }
                    </li>
                }
            </ul>
        }
    </div>

    <ServiceOrderDispatchDialog Visible="_dispatchDialogVisible"
                                 OnConfirm="ConfirmDispatch"
                                 OnCancel="() => _dispatchDialogVisible = false" />
}
