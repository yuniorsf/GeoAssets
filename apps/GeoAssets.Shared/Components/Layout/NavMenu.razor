@namespace GeoAssets.Shared.Components.Layout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@inject MenuRegistry Registry
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav

<nav class="nav nav-pills flex-column geo-nav">
    @foreach (var node in _tree)
    {
        @RenderNode(node)
    }
</nav>

@code {
    // RenderNode stays here rather than in NavMenu.razor.cs: it returns a RenderFragment built
    // via the `@<text>` Razor template syntax below, which only the Razor compiler understands —
    // a plain .cs partial can't contain it. Every other member of this component lives in
    // NavMenu.razor.cs (XD01-102).
    private RenderFragment RenderNode(MenuNode node) =>
    @<text>
        @switch (node.Item)
        {
            case MenuSectionItem section:
                <div class="geo-nav-section-label">@L[section.LabelKey]</div>
                break;

            case MenuGroupItem group:
                var isExpanded = _expandedGroupIds.Contains(group.Id);
                <button type="button" class="nav-link geo-nav-toggle" @onclick="() => ToggleGroup(group.Id)">
                    @if (group.Icon is not null)
                    {
                        <span class="geo-nav-icon">@group.Icon</span>
                    }
                    @L[group.LabelKey]
                    <span class="geo-nav-chevron">@(isExpanded ? "▾" : "▸")</span>
                </button>
                if (isExpanded)
                {
                    <div class="geo-nav-subitems">
                        @foreach (var child in node.Children)
                        {
                            @RenderNode(child)
                        }
                    </div>
                }
                break;

            case MenuPageItem pageItem:
                <NavLink class="@("nav-link" + (pageItem.ParentId is not null ? " geo-nav-sublink" : ""))"
                         href="@pageItem.RouteHref"
                         Match="@(pageItem.Match == MenuLinkMatch.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    @if (pageItem.Icon is not null)
                    {
                        <span class="geo-nav-icon">@pageItem.Icon</span>
                    }
                    @L[pageItem.LabelKey]
                </NavLink>
                break;

            case MenuPanelItem panel:
                var isOpen = _openPanelId == panel.Id;
                <button type="button" class="nav-link geo-nav-toggle @(isOpen ? "active" : "")" @onclick="() => TogglePanel(panel.Id)">
                    @if (panel.Icon is not null)
                    {
                        <span class="geo-nav-icon">@panel.Icon</span>
                    }
                    @L[panel.LabelKey]
                </button>
                if (isOpen)
                {
                    <div class="geo-nav-panel">
                        @if (typeof(IComponent).IsAssignableFrom(panel.ComponentType))
                        {
                            <DynamicComponent Type="panel.ComponentType" />
                        }
                    </div>
                }
                break;
        }
    </text>;
}
