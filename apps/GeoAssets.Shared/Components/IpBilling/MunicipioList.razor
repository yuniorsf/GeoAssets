@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.IpBilling.Repositories
@inject IMunicipioRepository Repository

<div class="sidebar-section">
    <div class="section-header-row">
        <h6>@L["admin.ipBilling.municipios.title"] (@_municipios.Count)</h6>
        <button class="btn-icon" title="@L["admin.ipBilling.municipios.newMunicipio"]" @onclick="() => OnCreateRequested.InvokeAsync()">＋</button>
    </div>
</div>

<div class="sidebar-scrollable">
    @if (_loading)
    {
        <div class="empty-state"><p>@L["app.loading"]</p></div>
    }
    else if (_municipios.Count == 0)
    {
        <div class="empty-state"><p>@L["admin.ipBilling.municipios.empty"]</p></div>
    }
    else
    {
        <div class="asset-list">
            @foreach (var municipio in _municipios)
            {
                <div class="asset-list-item @(SelectedMunicipioId == municipio.Id ? "selected" : "")"
                     @onclick="() => SelectMunicipio(municipio)">
                    <span class="asset-name">@municipio.Name</span>
                    <span style="color:var(--text-secondary)">@municipio.Uf · @municipio.IbgeCode</span>
                </div>
            }
        </div>
    }
</div>
