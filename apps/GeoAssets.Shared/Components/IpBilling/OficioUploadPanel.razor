@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using GeoAssets.IpBilling.Oficio
@using Microsoft.AspNetCore.Components.Forms
@inject IOficioRestClient Client

<div class="sidebar-section">
    <h5>@L["admin.ipBilling.oficios.uploadTitle"]</h5>
    <p style="color:var(--text-secondary)">@L["admin.ipBilling.oficios.uploadHint"]</p>

    <div class="form-group">
        <label>@L["admin.ipBilling.oficios.numeroPrefeitura"]</label>
        <input class="form-control" @bind="_numeroPrefeitura" disabled="@_uploading" />
    </div>

    <InputFile OnChange="OnFileSelectedAsync" disabled="@_uploading" />

    @if (_uploading)
    {
        <p>@L["admin.ipBilling.oficios.uploading"]</p>
    }

    @if (_successCount is { } count)
    {
        <p style="color:var(--success)">@L.GetString("admin.ipBilling.oficios.uploadSuccess", count)</p>
    }

    @if (_duplicateConflict is { } conflict)
    {
        <p class="attribute-errors">@conflict.Message</p>
        <div class="form-actions">
            <button class="btn btn-secondary" type="button" disabled="@_uploading" @onclick="HandleSupersedeAsync">
                @L["admin.ipBilling.oficios.supersedeAndRetry"]
            </button>
        </div>
    }
    else if (_rowErrors.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["admin.ipBilling.oficios.rowNumber"]</th>
                    <th>@L["admin.ipBilling.oficios.column"]</th>
                    <th>@L["admin.ipBilling.oficios.message"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in _rowErrors)
                {
                    <tr>
                        <td>@error.RowNumber</td>
                        <td>@error.Column</td>
                        <td>@error.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (!string.IsNullOrEmpty(_genericError))
    {
        <p class="attribute-errors">@_genericError</p>
    }
</div>
