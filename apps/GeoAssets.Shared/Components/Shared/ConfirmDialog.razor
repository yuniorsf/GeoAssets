@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase

@if (Visible)
{
    <div class="dialog-backdrop" @onclick="OnBackdropClick">
        <div class="dialog-box" @onclick:stopPropagation="true">
            <h6>@Title</h6>
            <p>@Message</p>
            <div class="dialog-actions">
                <button class="btn btn-secondary btn-sm" @onclick="Cancel">@L["assets.cancel"]</button>
                @if (!string.IsNullOrEmpty(SecondaryLabel))
                {
                    <button class="btn @SecondaryButtonClass btn-sm" @onclick="Secondary">@SecondaryLabel</button>
                }
                <button class="btn @ConfirmButtonClass btn-sm" @onclick="Confirm">@ConfirmLabel</button>
            </div>
        </div>
    </div>
}
