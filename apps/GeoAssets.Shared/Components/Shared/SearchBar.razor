@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase

<div class="search-bar">
    <span>🔍</span>
    <input type="text"
           placeholder="@L["assets.search"]"
           value="@Query"
           @oninput="OnInput" />
    @if (!string.IsNullOrEmpty(Query))
    {
        <button class="btn-icon" @onclick="Clear" title="@L["search.clear"]">✕</button>
    }
</div>
