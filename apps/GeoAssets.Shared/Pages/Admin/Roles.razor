@page "/admin/roles"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@using GeoAssets.Shared.Components.Admin
@inject IGeoAuthorizationService AuthService

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.roles.title"]</h1>
    </div>

    @if (_authorized == true)
    {
        <RoleList @ref="_list"
                  SelectedRoleId="@_selectedRoleId"
                  OnRoleSelected="OnRoleSelected"
                  OnCreateRequested="OnCreateRequested" />
    }
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else if (_showCreateForm)
    {
        <RoleForm IsNew="true" OnSaved="OnRoleSaved" OnCancel="() => _showCreateForm = false" />
    }
    else if (_selectedRoleId is not null)
    {
        <RoleForm RoleId="@_selectedRoleId"
                  OnSaved="OnRoleSaved"
                  OnCancel="() => _selectedRoleId = null"
                  OnDeleted="OnRoleDeleted" />
    }
    else
    {
        <div class="empty-state">@L["admin.roles.selectPrompt"]</div>
    }
</main>
