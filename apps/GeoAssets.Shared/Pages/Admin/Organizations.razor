@page "/admin/organizations"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@using GeoAssets.Shared.Components.Admin
@inject IGeoAuthorizationService AuthService

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.organizations.title"]</h1>
    </div>

    @if (_authorized == true)
    {
        <OrganizationList @ref="_list"
                           SelectedOrganizationId="@_selectedOrganizationId"
                           OnOrganizationSelected="OnOrganizationSelected"
                           OnCreateRequested="OnCreateRequested" />
    }
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else if (_showCreateForm)
    {
        <OrganizationForm IsNew="true" OnSaved="OnOrganizationSaved" OnCancel="() => _showCreateForm = false" />
    }
    else if (_selectedOrganizationId is not null)
    {
        <OrganizationForm OrganizationId="@_selectedOrganizationId"
                          OnSaved="OnOrganizationSaved"
                          OnCancel="() => _selectedOrganizationId = null" />
    }
    else
    {
        <div class="empty-state">@L["admin.organizations.selectPrompt"]</div>
    }
</main>
