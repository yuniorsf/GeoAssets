@page "/assets/table"
@attribute [Authorize]
@layout GeoAssets.Shared.Components.Layout.MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Core.Interfaces
@using GeoAssets.Core.Models
@using GeoAssets.Shared.Components.Shared
@inject IAssetProvider Repository

<div class="page-main">
    <div class="page-main-header">
        <h1>@L["assetsTable.title"]</h1>
    </div>

    <div class="assets-table-controls">
        <SearchBar Query="@_searchText" OnSearch="OnSearch" />

        <select class="form-select form-select-sm assets-table-type-filter" @onchange="OnTypeFilterChanged">
            <option value="">@L["assets.allTypes"]</option>
            @foreach (var t in _assetTypes)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>

        <select class="form-select form-select-sm assets-table-page-size" @onchange="OnPageSizeChanged">
            @foreach (var size in PageSizeOptions)
            {
                <option value="@size" selected="@(size == _pageSize)">@size</option>
            }
        </select>
    </div>

    @if (_loading && _result is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_result is { TotalCount: 0 })
    {
        <div class="empty-state">@L["assetsTable.empty"]</div>
    }
    else if (_result is not null)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="sortable-th" @onclick='() => OnSort("name")'>@L["assets.name"]@SortIndicator("name")</th>
                        <th>@L["assets.type"]</th>
                        <th>@L["assets.description"]</th>
                        <th class="sortable-th" @onclick='() => OnSort("createdAt")'>@L["orders.createdAt"]@SortIndicator("createdAt")</th>
                        <th class="sortable-th" @onclick='() => OnSort("updatedAt")'>@L["orders.updatedAt"]@SortIndicator("updatedAt")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feature in _result.Items)
                    {
                        <tr>
                            <td>@(string.IsNullOrEmpty(feature.Properties.Name) ? L["assets.noName"] : feature.Properties.Name)</td>
                            <td>@AssetTypeName(feature.Properties.AssetTypeId)</td>
                            <td>@feature.Properties.Description</td>
                            <td>@feature.Properties.CreatedAt</td>
                            <td>@feature.Properties.UpdatedAt</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="assets-table-pager">
            <span class="assets-table-pager-summary">@PagerSummary()</span>
            <nav aria-label="@L["assetsTable.title"]">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(CanGoPrevious ? "" : "disabled")">
                        <button type="button" class="page-link" @onclick="GoToPreviousPage" disabled="@(!CanGoPrevious)">@L["assetsTable.previous"]</button>
                    </li>
                    <li class="page-item @(CanGoNext ? "" : "disabled")">
                        <button type="button" class="page-link" @onclick="GoToNextPage" disabled="@(!CanGoNext)">@L["assetsTable.next"]</button>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
