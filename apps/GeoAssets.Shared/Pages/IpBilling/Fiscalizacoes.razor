@page "/admin/ip-billing/fiscalizacoes"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@using GeoAssets.IpBilling.Models
@using GeoAssets.IpBilling.Repositories
@using GeoAssets.Shared.Components.IpBilling
@using GeoAssets.Workflow.Orders
@inject IGeoAuthorizationService AuthService
@inject IMunicipioRepository MunicipioRepository

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.ipBilling.fiscalizacoes.title"]</h1>
    </div>

    @if (_authorized == true)
    {
        <FiscalizacaoList @ref="_list"
                           SelectedOrderId="@_selectedOrder?.Id"
                           OnOrderSelected="OnOrderSelected"
                           OnCreateRequested="OnCreateRequested" />
    }
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else if (_showCreateForm)
    {
        <div>
            <h5>@L["admin.ipBilling.fiscalizacoes.newFiscalizacao"]</h5>

            <EditForm Model="@_createModel" OnValidSubmit="HandleCreateAsync">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>@L["admin.ipBilling.municipios.title"]</label>
                    <InputSelect class="form-control" @bind-Value="_createModel.MunicipioIbgeCode">
                        <option value="">@L["admin.ipBilling.municipios.selectOrganization"]</option>
                        @foreach (var municipio in _municipios)
                        {
                            <option value="@municipio.IbgeCode">@municipio.Name (@municipio.Uf)</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label>@L["admin.ipBilling.fiscalizacoes.competencia"]</label>
                    <InputText class="form-control" @bind-Value="_createModel.Competencia" placeholder="yyyy-MM" />
                </div>

                @if (!string.IsNullOrEmpty(_createError))
                {
                    <p class="attribute-errors">@_createError</p>
                }

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">@L["assets.save"]</button>
                    <button class="btn btn-secondary" type="button" @onclick="() => _showCreateForm = false">@L["assets.cancel"]</button>
                </div>
            </EditForm>
        </div>
    }
    else if (_selectedOrder is not null)
    {
        <FiscalizacaoDetail Order="@_selectedOrder"
                            OnClose="() => _selectedOrder = null"
                            OnChanged="ReloadSelectedAsync" />
    }
    else
    {
        <div class="empty-state">@L["admin.ipBilling.fiscalizacoes.selectPrompt"]</div>
    }
</main>
