@page "/admin/ip-billing/distribuidoras"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@using GeoAssets.Shared.Components.IpBilling
@inject IGeoAuthorizationService AuthService

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.ipBilling.distribuidoras.title"]</h1>
    </div>

    @if (_authorized == true)
    {
        <DistribuidoraList @ref="_list"
                           SelectedDistribuidoraId="@_selectedDistribuidoraId"
                           OnDistribuidoraSelected="OnDistribuidoraSelected"
                           OnCreateRequested="OnCreateRequested" />
    }
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else if (_showCreateForm)
    {
        <DistribuidoraForm IsNew="true" OnSaved="OnDistribuidoraSavedAsync" OnCancel="() => _showCreateForm = false" />
    }
    else if (_selectedDistribuidoraId is { } selectedId)
    {
        <DistribuidoraForm DistribuidoraId="@selectedId"
                           OnSaved="OnDistribuidoraSavedAsync"
                           OnCancel="() => _selectedDistribuidoraId = null"
                           OnDeleted="OnDistribuidoraDeletedAsync" />

        <DistribuidoraLampWattageEditor DistribuidoraId="@selectedId" />
    }
    else
    {
        <div class="empty-state">@L["admin.ipBilling.distribuidoras.selectPrompt"]</div>
    }
</main>
