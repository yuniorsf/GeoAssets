@page "/admin/ip-billing/municipios"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@using GeoAssets.Shared.Components.IpBilling
@inject IGeoAuthorizationService AuthService

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.ipBilling.municipios.title"]</h1>
    </div>

    @if (_authorized == true)
    {
        <MunicipioList @ref="_list"
                       SelectedMunicipioId="@_selectedMunicipioId"
                       OnMunicipioSelected="OnMunicipioSelected"
                       OnCreateRequested="OnCreateRequested" />
    }
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else if (_showCreateForm)
    {
        <MunicipioForm IsNew="true" OnSaved="OnMunicipioSaved" OnCancel="() => _showCreateForm = false" />
    }
    else if (_selectedMunicipioId is not null)
    {
        <MunicipioForm MunicipioId="@_selectedMunicipioId"
                       OnSaved="OnMunicipioSaved"
                       OnCancel="() => _selectedMunicipioId = null"
                       OnDeleted="OnMunicipioDeleted" />
    }
    else
    {
        <div class="empty-state">@L["admin.ipBilling.municipios.selectPrompt"]</div>
    }
</main>
