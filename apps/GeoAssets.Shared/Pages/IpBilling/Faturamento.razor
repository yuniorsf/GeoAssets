@page "/admin/ip-billing/faturamento"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@using GeoAssets.IpBilling.Models
@using GeoAssets.IpBilling.Repositories
@using GeoAssets.Shared.Components.IpBilling
@inject IGeoAuthorizationService AuthService
@inject IMunicipioRepository MunicipioRepository

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.ipBilling.faturamento.title"]</h1>
    </div>
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else
    {
        <div class="form-group">
            <label>@L["admin.ipBilling.municipios.title"]</label>
            <select class="form-control" @bind="_filterMunicipioId" @bind:after="LoadRowsAsync">
                <option value="">@L["admin.ipBilling.municipios.selectOrganization"]</option>
                @foreach (var municipio in _municipios)
                {
                    <option value="@municipio.Id">@municipio.Name (@municipio.Uf)</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>@L["admin.ipBilling.oficios.competencia"]</label>
            <input class="form-control" @bind="_filterCompetencia" @bind:after="LoadRowsAsync" placeholder="yyyy-MM" />
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" type="button" @onclick="() => _showManualEntry = true">
                @L["admin.ipBilling.faturamento.newEntry"]
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_loadError))
        {
            <p class="attribute-errors">@_loadError</p>
        }

        <FaturamentoLedgerTable Rows="@_rows"
                                 MunicipioLabel="@MunicipioLabel"
                                 OnRecargaRequested="OnRecargaRequested" />

        <FaturamentoManualEntryDialog Visible="@_showManualEntry"
                                       Municipios="@_municipios"
                                       OnSaved="OnManualEntrySaved"
                                       OnCancel="() => _showManualEntry = false" />

        <FaturamentoRecargaDialog Visible="@_showRecarga"
                                   Target="@_recargaTarget"
                                   OnCompleted="OnRecargaCompleted"
                                   OnCancel="() => _showRecarga = false" />
    }
</main>
