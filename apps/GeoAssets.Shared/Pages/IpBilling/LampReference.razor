@page "/admin/ip-billing/lamp-reference"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@using GeoAssets.Shared.Components.IpBilling
@inject IGeoAuthorizationService AuthService

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.ipBilling.lampReference.title"]</h1>
    </div>

    @if (_authorized == true)
    {
        <LampTypeList SelectedLampTypeId="@_selectedLampType?.Id" OnLampTypeSelected="OnLampTypeSelected" />
    }
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else if (_selectedLampType is not null)
    {
        <div>
            <h5>@_selectedLampType.Name (@_selectedLampType.Code)</h5>

            @if (_selectedLampType.WattageOptions.Count == 0)
            {
                <p class="empty-state">@L["admin.ipBilling.lampReference.noWattageOptions"]</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>@L["admin.ipBilling.lampReference.wattage"]</th>
                            <th>@L["admin.ipBilling.lampReference.ballastLoss"]</th>
                            <th>@L["admin.ipBilling.lampReference.totalBilled"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var option in _selectedLampType.WattageOptions)
                        {
                            <tr>
                                <td>@option.WattageW W</td>
                                <td>@option.BallastLossW W</td>
                                <td>@option.TotalBilledW W</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else
    {
        <div class="empty-state">@L["admin.ipBilling.lampReference.selectPrompt"]</div>
    }
</main>
