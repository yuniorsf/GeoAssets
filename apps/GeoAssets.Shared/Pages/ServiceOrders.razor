@page "/service-orders"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Workflow.Orders
@using GeoAssets.Shared.Components.ServiceOrders
@using GeoAssets.Shared.Services
@inject IServiceOrderRepository Repository
@inject WorkflowPrincipalFactory PrincipalFactory

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["orders.title"]</h1>
    </div>

    @if (_principal is not null)
    {
        <ServiceOrderList SelectedOrderId="@_selectedOrder?.Id"
                           OnOrderSelected="OnOrderSelected"
                           OnCreateRequested="OnCreateRequested" />
    }
</aside>

<main class="order-main">
    @if (_principal is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_showCreateForm)
    {
        <ServiceOrderCreateForm Principal="@_principal" OnSave="OnOrderCreated" OnCancel="() => _showCreateForm = false" />
    }
    else if (_selectedOrder is not null)
    {
        <ServiceOrderDetail Order="@_selectedOrder"
                             Principal="@_principal"
                             OnClose="() => _selectedOrder = null"
                             OnChanged="ReloadSelectedAsync" />
    }
    else
    {
        <div class="empty-state">@L["orders.selectPrompt"]</div>
    }
</main>
