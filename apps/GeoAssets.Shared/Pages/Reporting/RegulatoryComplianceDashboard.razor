@page "/admin/reporting/regulatory-compliance"
@attribute [Authorize]
@layout MainLayout
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using GeoAssets.Identity.Authorization.Services
@inject IGeoAuthorizationService AuthService

<aside class="sidebar">
    <div class="sidebar-header">
        <h1>@L["admin.reporting.regulatoryDashboard.title"]</h1>
    </div>
</aside>

<main class="order-main">
    @if (_authorized is null)
    {
        <div class="empty-state">@L["app.loading"]</div>
    }
    else if (_authorized == false)
    {
        <div class="empty-state">@L["admin.accessDenied"]</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@L["admin.reporting.regulatoryDashboard.slaBreaches.title"]</h5>

                @if (_summary is null)
                {
                    <p>@L["app.loading"]</p>
                }
                else if (!_summary.IsEngineConfigured)
                {
                    <p class="text-secondary">@L["admin.reporting.regulatoryDashboard.slaBreaches.notConfigured"]</p>
                }
                else
                {
                    <p class="fs-4">@_summary.TotalBreaches</p>

                    @if (_summary.BreachesByServiceCategory.Count > 0)
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>@L["admin.reporting.regulatoryDashboard.slaBreaches.category"]</th>
                                    <th>@L["admin.reporting.regulatoryDashboard.slaBreaches.count"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (category, count) in _summary.BreachesByServiceCategory.OrderByDescending(kv => kv.Value))
                                {
                                    <tr>
                                        <td>@category</td>
                                        <td>@count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@L["admin.reporting.regulatoryDashboard.anaTypology.title"]</h5>
                <p class="text-secondary">@L["admin.reporting.regulatoryDashboard.anaTypology.notAvailable"]</p>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@L["admin.reporting.regulatoryDashboard.bdgdCompliance.title"]</h5>
                <p class="text-secondary">@L["admin.reporting.regulatoryDashboard.bdgdCompliance.notAvailable"]</p>
            </div>
        </div>
    }
</main>
