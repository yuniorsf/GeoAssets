@page "/"
@attribute [Authorize]
@inherits GeoAssets.Shared.Components.Localization.LocalizedComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using GeoAssets.Core.Interfaces
@using GeoAssets.Core.Models
@using GeoAssets.Core.Models.Geometry
@using GeoAssets.Core.Services
@using GeoAssets.Shared.Components.Assets
@using GeoAssets.Shared.Components.Layers
@using GeoAssets.Shared.Components.Map
@using GeoAssets.Shared.Components.Providers
@using GeoAssets.Shared.Components.Shared
@using GeoAssets.Identity.Authentication
@using GeoAssets.Identity.Authorization.Repositories
@using GeoAssets.Identity.Authorization.Services
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject IAssetProvider Repository
@inject AssetService AssetSvc
@inject IMapInterop MapInterop
@inject IBootLoader BootLoader
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthNavigationService AuthNav
@inject IGeoAuthorizationService AuthService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IUserRepository UserRepository
@inject IServiceProvider ServiceProvider

<div class="geoassets-app">

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <span style="font-size:1.4rem">🗺️</span>
            <h1>GeoAssets</h1>
        </div>

        <NavMenu ShowAdmin="@_showAdminNavLink"
                 ShowProviders="@_showProviders"
                 ShowLayers="@_showLayers"
                 ShowAssetList="@_showAssetList"
                 OnToggleProviders="ToggleProviders"
                 OnToggleLayers="ToggleLayers"
                 OnToggleAssetList="ToggleAssetList" />

        @if (_showProviders)
        {
            <ProviderPoolPanel @ref="_providerPoolPanel" MapDivId="@_mapDivId" />
        }

        @if (_showLayers)
        {
            <LayerManager MapDivId="@_mapDivId" />
        }

        @if (_showAssetList)
        {
            <AssetList SelectedFeatureId="@_selectedFeature?.Id"
                       OnFeatureSelected="OnFeatureSelected"
                       OnFeatureDeleted="OnFeatureDeletedFromList" />
        }
    </aside>

    <!-- Content column: topbar + map area -->
    <div class="content-column">
        <TopBar UserDisplayName="@_userDisplayName"
                OrganizationName="@_organizationName"
                Roles="@_userRoles"
                OnSignOut="SignOut" />

        <!-- Map Area -->
        <main class="map-area">
            <DrawToolbar @ref="_drawToolbar"
                         MapDivId="@_mapDivId"
                         OnDrawModeChanged="OnDrawModeChanged" />

            <MapContainer @ref="_mapContainer"
                          DivId="@_mapDivId"
                          InitLat="18.5"
                          InitLon="-69.9"
                          InitZoom="7"
                          OnFeatureDrawn="OnFeatureDrawn"
                          OnFeatureEdited="OnFeatureEdited"
                          OnFeatureClicked="OnFeatureClicked"
                          OnFeatureContextMenu="OnFeatureContextMenu" />

            <!-- Properties Panel -->
            @if (_selectedFeature is not null)
            {
                <div class="properties-panel">
                    <AssetForm @ref="_assetForm"
                               Feature="@_selectedFeature"
                               IsNew="@_isNewFeature"
                               OnSave="OnFeatureSaved"
                               OnCancel="ClosePanel" />
                </div>
            }
        </main>
    </div>
</div>

<!-- Map context menu (rendered outside map-area so fixed positioning works correctly) -->
<MapContextMenu Visible="_contextVisible"
                X="_contextX"
                Y="_contextY"
                ShowSave="_selectedFeature?.Id == _contextFeatureId"
                OnEdit="ContextMenuEdit"
                OnSave="ContextMenuSave"
                OnDelete="ContextMenuDelete"
                OnClose="CloseContextMenu" />

<!-- Provider boot dialog — shown on first launch until a data source is connected.
     Backdrop click is ignored in boot mode; user must make an explicit choice. -->
<ProviderConnectDialog Visible="@(!BootLoader.IsBootComplete)" IsBootMode="true"
                       OnProviderConnected="EventCallback.Factory.Create<ProviderEntry>(this, HandleBootProviderConnected)" />

<!-- Delete confirmation triggered from context menu -->
<ConfirmDialog Visible="_showDeleteConfirm"
               Title="@L["assets.deleteTitle"]"
               Message="@L.GetString("assets.deleteConfirm", _pendingDeleteName)"
               ConfirmLabel="@L["assets.delete"]"
               OnConfirm="ConfirmContextDelete"
               OnCancel="() => { _showDeleteConfirm = false; StateHasChanged(); }" />

@code {
    private const string _mapDivId = "geoassets-map";

    private MapContainer?      _mapContainer;
    private DrawToolbar?       _drawToolbar;
    private AssetForm?         _assetForm;
    private ProviderPoolPanel? _providerPoolPanel;

    private GeoFeature? _selectedFeature;
    private bool _isNewFeature;

    private string _userDisplayName = string.Empty;
    private string? _organizationName;
    private IReadOnlyList<string> _userRoles = [];
    private bool _showAdminNavLink;

    private bool _showProviders  = true;
    private bool _showLayers     = true;
    private bool _showAssetList  = true;

    // ─── Context menu state ────────────────────────────────────────────────

    private bool   _contextVisible;
    private string _contextFeatureId = string.Empty;
    private double _contextX;
    private double _contextY;

    private bool   _showDeleteConfirm;
    private string _pendingDeleteId   = string.Empty;
    private string _pendingDeleteName = string.Empty;

    // ─── Init ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await AssetSvc.InitializeAsync();

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user  = state.User;
        _userDisplayName = user.FindFirst("name")?.Value
                        ?? user.FindFirst("preferred_username")?.Value
                        ?? user.Identity?.Name
                        ?? L["app.defaultUser"];

        // Ensure the local user record exists before checking authorization. Only relevant
        // under Identity:Backend=InMemory (Rest has no local provisioning step, so the service
        // isn't registered there — resolved optionally to avoid breaking that backend).
        var provisioning = ServiceProvider.GetService<UserProvisioningService>();
        if (provisioning is not null)
            await provisioning.EnsureProvisionedAsync();

        try
        {
            _showAdminNavLink = await AuthService.HasPermissionAsync("users:read");
        }
        catch (Exception ex)
        {
            // Showing the admin nav icon is optional — a failure here (e.g. the identity
            // backend being unreachable) must not take down the map page itself.
            Console.Error.WriteLine($"[Index] Failed to resolve admin nav visibility: {ex.Message}");
            _showAdminNavLink = false;
        }

        try
        {
            var currentUser = await CurrentUserAccessor.GetCurrentUserAsync();
            _userRoles = currentUser?.ExternalRoles ?? [];

            // IOrganizationRepository is only registered under Identity:Backend=InMemory
            // (see GeoIdentityRestExtensions) — resolved optionally so the Rest backend,
            // which has no org endpoint yet, just shows the topbar without an org name.
            var organizationRepo = ServiceProvider.GetService<IOrganizationRepository>();
            _organizationName = await ResolveOrganizationNameAsync(currentUser, organizationRepo, UserRepository);
        }
        catch (Exception ex)
        {
            // Organization/role display in the topbar is optional — a failure here (e.g. the
            // identity backend being unreachable) must not take down the map page itself.
            Console.Error.WriteLine($"[Index] Failed to resolve topbar identity info: {ex.Message}");
        }
    }

    /// <summary>
    /// Resolves the display name of the current user's organization for the topbar.
    /// Returns <c>null</c> whenever an org name can't be determined — no organization
    /// repository registered (e.g. Identity:Backend=Rest, XD01-77 tracks a real org
    /// endpoint there), no current user, or the user has no organization assigned yet.
    /// </summary>
    public static async Task<string?> ResolveOrganizationNameAsync(
        CurrentUser?             currentUser,
        IOrganizationRepository? organizationRepo,
        IUserRepository          userRepository,
        CancellationToken        ct = default)
    {
        if (organizationRepo is null || currentUser is null) return null;

        var appUser = await userRepository.GetByExternalObjectIdAsync(currentUser.ExternalObjectId, ct);
        if (appUser?.OrganizationId is not { } organizationId) return null;

        var organization = await organizationRepo.GetByIdAsync(organizationId, ct);
        return organization?.Name;
    }

    private void SignOut() => AuthNav.NavigateToLogout();

    // ─── Nav panel toggles ────────────────────────────────────────────────

    private void ToggleProviders()  { _showProviders  = !_showProviders;  StateHasChanged(); }
    private void ToggleLayers()     { _showLayers     = !_showLayers;     StateHasChanged(); }
    private void ToggleAssetList()  { _showAssetList  = !_showAssetList;  StateHasChanged(); }

    // ─── Boot ─────────────────────────────────────────────────────────────

    private async Task HandleBootProviderConnected(ProviderEntry entry) =>
        await (_providerPoolPanel?.HandleProviderConnected(entry) ?? Task.CompletedTask);

    // ─── Draw events ──────────────────────────────────────────────────────

    private void OnDrawModeChanged(GeometryType? mode)
    {
        if (mode.HasValue) ClosePanel();
    }

    private void OnFeatureDrawn(GeoFeature feature)
    {
        _selectedFeature = feature;
        _isNewFeature = true;
        _drawToolbar?.ResetMode();
        StateHasChanged();
    }

    private void OnFeatureEdited(GeoFeature feature) => StateHasChanged();

    // ─── Selection / click ────────────────────────────────────────────────

    private async Task OnFeatureSelected(GeoFeature feature)
    {
        _selectedFeature = feature;
        _isNewFeature = false;
        StateHasChanged();
        await (_mapContainer?.PanToFeatureAsync(feature.Id) ?? Task.CompletedTask);
    }

    private async Task OnFeatureClicked(string featureId)
    {
        var feature = Repository.GetById(featureId);
        if (feature is not null)
            await OnFeatureSelected(feature);
    }

    // ─── Context menu ─────────────────────────────────────────────────────

    private void OnFeatureContextMenu((string FeatureId, double X, double Y) ctx)
    {
        _contextFeatureId = ctx.FeatureId;
        _contextX         = ctx.X;
        _contextY         = ctx.Y;
        _contextVisible   = true;
        StateHasChanged();
    }

    private void CloseContextMenu()
    {
        _contextVisible = false;
        StateHasChanged();
    }

    private async Task ContextMenuEdit()
    {
        var feature = Repository.GetById(_contextFeatureId);
        if (feature is not null)
            await OnFeatureSelected(feature);
    }

    private async Task ContextMenuSave()
    {
        if (_assetForm is not null)
            await _assetForm.SaveAsync();
    }

    private void ContextMenuDelete()
    {
        var feature = Repository.GetById(_contextFeatureId);
        if (feature is null) return;
        _pendingDeleteId   = feature.Id;
        _pendingDeleteName = string.IsNullOrEmpty(feature.Properties.Name)
            ? L["assets.noName"]
            : feature.Properties.Name;
        _showDeleteConfirm = true;
        StateHasChanged();
    }

    private void ConfirmContextDelete()
    {
        if (!string.IsNullOrEmpty(_pendingDeleteId))
        {
            Repository.Delete(_pendingDeleteId);
            if (_selectedFeature?.Id == _pendingDeleteId)
                ClosePanel();
        }
        _pendingDeleteId   = string.Empty;
        _pendingDeleteName = string.Empty;
        _showDeleteConfirm = false;
        StateHasChanged();
    }

    // ─── Form actions ─────────────────────────────────────────────────────

    private void OnFeatureSaved(GeoFeature _) => ClosePanel();
    private void OnFeatureDeletedFromList(GeoFeature _) => ClosePanel();
    private void ClosePanel() { _selectedFeature = null; StateHasChanged(); }

    public async ValueTask DisposeAsync() => await AssetSvc.DisposeAsync();
}
