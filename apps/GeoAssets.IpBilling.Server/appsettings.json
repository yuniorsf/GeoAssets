      "Protocol": "Grpc"
    },
    "Instrumentation": { "EnableEFCore": true, "EnableRuntime": true }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

