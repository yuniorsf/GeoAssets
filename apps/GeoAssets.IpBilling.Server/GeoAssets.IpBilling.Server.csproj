<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.IpBilling.Server</RootNamespace>
    <UserSecretsId>geoassets-ipbilling-server</UserSecretsId>
    <!-- NU1510 fires on the System.Security.Cryptography.Xml pin below — same pre-existing,
         out-of-scope NuGet pruning-heuristic false positive as GeoAssets.Server.csproj/
         GeoAssets.FieldService.Server.csproj (XD01-294). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1510</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.IpBilling.Tests" />
    <InternalsVisibleTo Include="GeoAssets.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Bearer-token authentication (XD01-177) — closes the gap EntraCiamServerAuthenticationProvider's
         own doc comment (in GeoAssets.FieldService.Server) flagged: this host registered no
         authentication at all. -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- Pin past the vulnerable 10.0.10 pulled transitively by Microsoft.Identity.Web.TokenCache
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj) —
         same pin as GeoAssets.Server.csproj/GeoAssets.FieldService.Server.csproj. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Core\GeoAssets.Core.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Identity\GeoAssets.Identity.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.IpBilling\GeoAssets.IpBilling.csproj" />
    <ProjectReference Include="..\..\ipbilling\GeoAssets.IpBilling.EFCore\GeoAssets.IpBilling.EFCore.csproj" />
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.Rest\GeoAssets.Provider.Rest.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Workflow\GeoAssets.Workflow.csproj" />
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.EFCore\GeoAssets.Workflow.EFCore.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Infrastructure.Observability\GeoAssets.Infrastructure.Observability.csproj" />
  </ItemGroup>

</Project>
