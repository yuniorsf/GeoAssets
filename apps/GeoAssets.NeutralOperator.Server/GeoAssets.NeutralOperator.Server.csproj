<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- XD01-382 (ADR-001 Phase 7): the NeutralOperator vertical's own microservice on the order-type chassis — the generic
       workflow engine over its own ServiceOrderDbContext (database geoassets_neutral_operator, migrations in this
       assembly), the NeutralOperator module and its NeutralOperatorDbContext, kernel communication over REST only. It
       never opens the kernel's database: features, selection, the target ledger and identity are the kernel's REST APIs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.NeutralOperator.Server</RootNamespace>
    <UserSecretsId>geoassets-neutral-operator-server</UserSecretsId>
    <!-- NU1510 fires on the System.Security.Cryptography.Xml pin below — the same NuGet pruning-heuristic false positive
         as GeoAssets.Server.csproj / GeoAssets.FieldService.Server.csproj; the NoWarn="NU1510" item metadata on the
         PackageReference itself is what covers the solution-wide restore (XD01-294). -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1510</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GeoAssets.NeutralOperator.Server.Tests" />
    <!-- XD01-397: the two-audience end-to-end test boots this host next to the kernel's real bearer validation. -->
    <InternalsVisibleTo Include="GeoAssets.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- App-only (client-credentials) token acquisition as GeoAssets.ServiceCaller (XD01-299) for the kernel's
         machine-to-machine routes — already a transitive dependency of Microsoft.Identity.Web. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.87.0" />
    <!-- Pin past the vulnerable 10.0.10 pulled transitively by Microsoft.Identity.Web.TokenCache
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj) — same pin as the other hosts. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\GeoAssets.Core\GeoAssets.Core.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Identity\GeoAssets.Identity.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Hosting.Abstractions\GeoAssets.Hosting.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Infrastructure.Observability\GeoAssets.Infrastructure.Observability.csproj" />
    <ProjectReference Include="..\..\core\GeoAssets.Workflow\GeoAssets.Workflow.csproj" />
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.EFCore\GeoAssets.Workflow.EFCore.csproj" />
    <!-- The order-type chassis' HTTP surface: generic service-order, target and selection routes, their authorization. -->
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.Hosting\GeoAssets.Workflow.Hosting.csproj" />
    <!-- The kernel's REST clients: the global target ledger and the bootstrap registration (machine to machine). -->
    <ProjectReference Include="..\..\workflow\GeoAssets.Workflow.Rest\GeoAssets.Workflow.Rest.csproj" />
    <!-- Features through the kernel's REST API (IGeoCoreClient, organization-scoped reads — XD01-386). -->
    <ProjectReference Include="..\..\providers\GeoAssets.Provider.Rest\GeoAssets.Provider.Rest.csproj" />
    <!-- Tenant interceptors for this host's own ServiceOrderDbContext (row-level security). -->
    <ProjectReference Include="..\..\providers\GeoAssets.Persistence.Postgres\GeoAssets.Persistence.Postgres.csproj" />
    <ProjectReference Include="..\..\verticals\NeutralOperator\GeoAssets.NeutralOperator.Modules\GeoAssets.NeutralOperator.Modules.csproj" />
  </ItemGroup>

</Project>
