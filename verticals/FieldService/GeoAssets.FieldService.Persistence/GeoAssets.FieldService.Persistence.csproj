<Project Sdk="Microsoft.NET.Sdk">

  <!-- XD01-381 (ADR-001 Phase 6): the FieldService vertical's persistence — the contractor US ledger, the US catalog, the
       contractor US postings, the ICERP paving measurements and the manhole audits in FieldServiceDbContext (schema
       field_service, its own migrations and history table), moved out of the kernel's ServiceOrderDbContext, plus the
       inspection commit that writes them. Until Phase 7 it shares the kernel context's connection and transaction, so it
       references the engine's persistence (a vertical → engine reference; never the reverse). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoAssets.FieldService.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests of this code stayed where they were when it moved out of GeoAssets.Workflow.EFCore (XD01-381). -->
    <InternalsVisibleTo Include="GeoAssets.Workflow.EFCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <!-- Design-time only: lets dotnet ef run with this project as its own startup project (FieldServiceDbContextFactory). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoAssets.FieldService.Application\GeoAssets.FieldService.Application.csproj" />
    <!-- The paving spawn reads the recorded trench (TrenchDimensions) off the inspected order (XD01-291). -->
    <ProjectReference Include="..\..\..\core\GeoAssets.Domain.Sanitation\GeoAssets.Domain.Sanitation.csproj" />
    <ProjectReference Include="..\..\..\workflow\GeoAssets.Workflow.EFCore\GeoAssets.Workflow.EFCore.csproj" />
    <ProjectReference Include="..\..\..\providers\GeoAssets.Persistence.Postgres\GeoAssets.Persistence.Postgres.csproj" />
  </ItemGroup>

</Project>
